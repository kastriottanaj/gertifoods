---
// Astro port of src/components/Navbar.jsx — same DOM, same class names, same
// aria attributes, same SVG paths, so it renders pixel-identically.
//
// Two deliberate differences, both invisible to a visitor:
//
// 1. <a href> replaces react-router's <Link to>. Astro is a multi-page app, so
//    navigation is a real page load. With these pages shipping no application
//    JS, that is typically faster than the SPA's client-side transition was.
//
// 2. The interactive bits (hamburger, areas dropdown) run as a few lines of
//    vanilla JS instead of React. Hydrating this as a React island
//    would pull ~190 KB of React onto every page on the site — the exact cost
//    the migration exists to remove — for a menu toggle and a dropdown.
import { useTranslations, localePath } from '../lib/i18n.js';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { areas } from '../../src/data/areas.js';
import brandLogo from '../../src/assets/gerti-foods-logo.webp';

const CALENDLY_URL = 'https://calendly.com/arlinda-gertifoods/30min';

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);
---

<nav class="navbar">
  <div class="navbar-container">
    <a href={p('/')} class="navbar-brand" aria-label="Gerti Foods">
      {/* Above the fold on every route: stays eager. width/height give the
          browser the intrinsic ratio so the auto-width logo box doesn't
          shift the navbar once the file lands. */}
      <img src={brandLogo.src} alt="Gerti Foods" width="164" height="89" decoding="async" />
    </a>

    {/* Desktop links */}
    <div class="navbar-links">
      <a href={p('/products')}>{t('nav_products')}</a>
      <a href={p('/about')}>{t('nav_about')}</a>
      <a href={p('/blog')}>{t('nav_blog')}</a>
      <div class="nav-dropdown" data-areas-dropdown>
        <div class="nav-dropdown-trigger">
          <a href={p('/areas')}>{t('nav_areas')}</a>
          <button
            type="button"
            class="nav-dropdown-caret"
            aria-label={t('nav_areas')}
            aria-expanded="false"
            data-areas-caret
          >
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
        <div class="nav-dropdown-menu" role="menu" data-areas-menu style="display:none">
          {areas.map((area) => (
            <a href={p(`/areas/${area.slug}`)} role="menuitem">{t(area.nameKey)}</a>
          ))}
        </div>
      </div>
      <a href={p('/imprint')}>{t('nav_imprint')}</a>

      <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="navbar-book-btn">
        {t('footer_book_meeting')}
      </a>
      <LanguageSwitcher lang={lang} />
    </div>

    {/* Hamburger button */}
    <button
      class="navbar-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="navbar-mobile-menu"
      data-menu-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-icon-open>
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-icon-close style="display:none">
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  {/* Mobile / tablet menu */}
  <div class="navbar-overlay" aria-hidden="true" data-menu-overlay style="display:none"></div>
  <div id="navbar-mobile-menu" class="navbar-mobile" data-mobile-menu>
    <a href={p('/products')}>{t('nav_products')}</a>
    <a href={p('/about')}>{t('nav_about')}</a>
    <a href={p('/blog')}>{t('nav_blog')}</a>

    {/* Areas accordion */}
    <div class="navbar-mobile-accordion">
      <div class="navbar-mobile-accordion-row">
        <a href={p('/areas')}>{t('nav_areas')}</a>
        <button
          type="button"
          class="navbar-mobile-accordion-toggle"
          aria-label={t('nav_areas')}
          aria-expanded="false"
          data-mobile-areas-toggle
        >
          <svg width="16" height="16" viewBox="0 0 12 12" aria-hidden="true" style="transition: transform 0.2s;" data-mobile-areas-caret>
            <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
      <div class="navbar-mobile-subnav" data-mobile-areas-menu style="display:none">
        {areas.map((area) => (
          <a href={p(`/areas/${area.slug}`)}>{t(area.nameKey)}</a>
        ))}
      </div>
    </div>

    <a href={p('/imprint')}>{t('nav_imprint')}</a>

    <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="navbar-book-btn">
      {t('footer_book_meeting')}
    </a>
    <LanguageSwitcher lang={lang} />
  </div>
</nav>

<script>
  // --- Mobile menu -------------------------------------------------------
  // Mirrors Navbar.jsx: toggles .is-open, swaps the hamburger/close icons and
  // locks body scroll while the menu is open.
  const toggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const overlay = document.querySelector('[data-menu-overlay]');
  const iconOpen = document.querySelector('[data-icon-open]');
  const iconClose = document.querySelector('[data-icon-close]');
  const mobileAreasToggle = document.querySelector('[data-mobile-areas-toggle]');
  const mobileAreasMenu = document.querySelector('[data-mobile-areas-menu]');
  const mobileAreasCaret = document.querySelector('[data-mobile-areas-caret]');

  function setMenu(open) {
    mobileMenu?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (iconOpen) iconOpen.style.display = open ? 'none' : '';
    if (iconClose) iconClose.style.display = open ? '' : 'none';
    if (overlay) overlay.style.display = open ? '' : 'none';
    document.body.style.overflow = open ? 'hidden' : '';
    if (!open) setMobileAreas(false);
  }

  function setMobileAreas(open) {
    if (mobileAreasMenu) mobileAreasMenu.style.display = open ? 'flex' : 'none';
    mobileAreasToggle?.setAttribute('aria-expanded', String(open));
    if (mobileAreasCaret) mobileAreasCaret.style.transform = open ? 'rotate(180deg)' : 'none';
  }

  toggle?.addEventListener('click', () => {
    setMenu(!mobileMenu?.classList.contains('is-open'));
  });
  overlay?.addEventListener('click', () => setMenu(false));
  mobileAreasToggle?.addEventListener('click', () => {
    setMobileAreas(mobileAreasMenu?.style.display === 'none');
  });

  // --- Desktop "Areas" dropdown -----------------------------------------
  // Same triggers as the React version: open on hover, toggle with the caret,
  // close on an outside mousedown.
  const dropdown = document.querySelector('[data-areas-dropdown]');
  const caret = document.querySelector('[data-areas-caret]');
  const menu = document.querySelector('[data-areas-menu]');

  function setAreas(open) {
    if (menu) menu.style.display = open ? 'flex' : 'none';
    caret?.setAttribute('aria-expanded', String(open));
  }

  dropdown?.addEventListener('mouseenter', () => setAreas(true));
  dropdown?.addEventListener('mouseleave', () => setAreas(false));
  caret?.addEventListener('click', () => setAreas(menu?.style.display === 'none'));
  document.addEventListener('mousedown', (e) => {
    if (dropdown && !dropdown.contains(e.target as Node)) setAreas(false);
  });
</script>
