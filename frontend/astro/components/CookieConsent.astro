---
// Astro port of src/components/CookieConsent.jsx — same markup, classes, copy
// and consent semantics.
//
// The banner ships in the HTML with display:none and is revealed by the script
// below only when no choice is stored. That ordering matters: rendering it
// visible and hiding it afterwards would flash the banner at every returning
// visitor who already answered. React avoided this by not rendering until
// hydration; here the equivalent is starting hidden.
import { localePath } from '../lib/i18n.js';

const CONSENT_KEY = 'gf_cookie_consent';

const COPY = {
  sq: {
    message: 'Përdorim cookies për analitikë dhe marketing, që të kuptojmë vizitorët dhe të përmirësojmë ofertat tona.',
    imprintLink: 'Impresum dhe cookies',
    accept: 'Prano',
    reject: 'Refuzo',
  },
  en: {
    message: 'We use cookies for analytics and marketing to understand visitors and improve our offers.',
    imprintLink: 'Imprint and cookies',
    accept: 'Accept',
    reject: 'Decline',
  },
  de: {
    message: 'Wir verwenden Cookies für Analyse und Marketing, um Besucher zu verstehen und unsere Angebote zu verbessern.',
    imprintLink: 'Impressum und Cookies',
    accept: 'Akzeptieren',
    reject: 'Ablehnen',
  },
};

const { lang } = Astro.props;
const c = COPY[lang] || COPY.en;
---

<div
  class="cookie-consent"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
  data-cookie-consent
  style="display:none"
>
  <p class="cookie-consent-text">
    {c.message}{' '}
    <a href={localePath(lang, '/imprint')} class="cookie-consent-link">{c.imprintLink}</a>
  </p>
  <div class="cookie-consent-actions">
    <button type="button" class="cookie-btn cookie-btn-reject" data-consent="denied">
      {c.reject}
    </button>
    <button type="button" class="cookie-btn cookie-btn-accept" data-consent="granted">
      {c.accept}
    </button>
  </div>
</div>

<script>
  const CONSENT_KEY = 'gf_cookie_consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');

  // Same Consent Mode v2 update the React version sent, so the gtag/fbq
  // defaults declared in the document head are lifted on exactly the same
  // signal.
  function updateConsent(granted: boolean) {
    const v = granted ? 'granted' : 'denied';
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('consent', 'update', {
        ad_storage: v,
        ad_user_data: v,
        ad_personalization: v,
        analytics_storage: v,
      });
      // BaseLayout already sends this document's page_view under the current
      // consent state. Do not send it again after acceptance: that would turn
      // one visit into two page views in GA4.
    }
    if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('consent', granted ? 'grant' : 'revoke');
    }
  }

  let answered = false;
  try {
    answered = !!localStorage.getItem(CONSENT_KEY);
  } catch {
    answered = false;
  }

  if (!answered && banner) {
    banner.style.display = 'flex';
  }

  banner?.querySelectorAll<HTMLElement>('[data-consent]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const granted = btn.dataset.consent === 'granted';
      try {
        localStorage.setItem(CONSENT_KEY, granted ? 'granted' : 'denied');
      } catch {
        /* ignore */
      }
      updateConsent(granted);
      banner.style.display = 'none';
    });
  });
</script>
