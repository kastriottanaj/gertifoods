---
// Five stars with the filled portion clipped to the real rating: a grey row
// underneath, a gold row on top cut to GOOGLE_STAR_FILL. Screen readers get
// the number; the glyphs are decoration.
import { GOOGLE_RATING, GOOGLE_STAR_FILL } from '../lib/reviews.js';
---

<span class="gstars" style={`--fill: ${GOOGLE_STAR_FILL}`} role="img" aria-label={`${GOOGLE_RATING} / 5`}>
  <span aria-hidden="true">★★★★★</span>
  <span class="gstars-fill" aria-hidden="true">★★★★★</span>
</span>
