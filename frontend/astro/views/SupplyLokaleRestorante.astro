---
// /furnizim/lokale-restorante — the cafés/restaurants/hotels landing page,
// built to Kastriot's mockup (2026-09-16). Same system as the furra-buke
// page — LandingHeader, the shared landing.css cards and strip — with its own
// hero (the pack and wraps in a restaurant kitchen), centred section
// headings and three icons of its own: oven, snowflake, wrap. On phones the
// text block sits on the kitchen background, then the products band follows.
// The mockup's testimonial is left out, as on the other pages.
//
// Copy stays under supply_lokale_restorante_* in translations.js; the
// "request a quote" buttons open the site's sample/offer modal.
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import ModalHost from '../islands/ModalHost.jsx';
import { islandMessages } from '../lib/islandMessages.js';
import { useTranslations, localePath } from '../lib/i18n.js';
import { breadcrumbSchema, jsonLd } from '../lib/schema.js';
import heroImage from '../../src/assets/lokale-restorante-hero.webp';
import kitchenImage from '../../src/assets/hospitality-kitchen.webp';
import tortillaImage from '../../src/assets/products/Tortillas.webp';
import '../styles/supply-lokale-restorante.css';

const PHONE = '+383 49 111 150';
const PHONE_HREF = 'tel:+38349111150';

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);
const k = (suffix) => t(`supply_lokale_restorante_${suffix}`);
const messages = islandMessages(lang);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema([
      { name: t('footer_home'), url: new URL(p('/'), Astro.site).href },
      { name: t('supply_breadcrumb'), url: new URL(p('/furnizim'), Astro.site).href },
      { name: k('name') },
    ]),
  ],
};
---

<BaseLayout
  title={k('seo_title')}
  description={k('meta')}
  lang={lang}
  appClass=" landing-app lokale-landing-app"
  brandSuffix={false}
  showNavbar={false}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd(schema)} />

  <div class="lp lr">
    <LandingHeader lang={lang} ctaLabel={k('cta_primary')} langStyle="name" />

    <section class="lp-hero lr-hero" style={`--lr-kitchen: url(${kitchenImage.src})`}>
      <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={k('hero_alt')} class="lp-hero-img" fetchpriority="high" />
      <div class="lp-hero-shade"></div>
      <div class="lp-wrap lp-hero-inner">
        <p class="lp-eyebrow">{k('eyebrow')}</p>
        <h1>{k('hero_line_1')}<br />{k('hero_line_2')}</h1>
        <p class="lp-hero-body">{k('hero_body')}</p>
        <div class="lp-hero-actions">
          <button type="button" class="lp-btn lp-btn-red" data-open-modal="sample">
            {k('cta_primary')}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
          </button>
          <a href="#produktet" class="lp-btn lp-btn-outline">
            {k('cta_secondary')}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11 4v12.17l-5.59-5.58L4 12l8 8 8-8-1.41-1.41L13 16.17V4z"/></svg>
          </a>
        </div>
        <p class="lp-hero-meta">
          <a href={PHONE_HREF}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01z"/></svg>
            {PHONE}
          </a>
          <span aria-hidden="true">·</span>
          <span>{k('hero_meta')}</span>
        </p>
      </div>
    </section>

    <section class="lp-trust lp-trust-centered">
      <div class="lp-wrap lp-trust-inner">
        <div class="lp-trust-lead">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/></svg>
          <b>{k('trust')}</b>
        </div>
        <ul class="lp-trust-list">
          <li>ISO 22000</li><li>HACCP</li><li>IFS</li><li>BRC</li><li>Halal</li>
        </ul>
      </div>
    </section>

    <section class="lp-wrap lp-benefits">
      <h2 class="lp-center">{k('why_title')}</h2>
      <div class="lp-benefit-grid">
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3.5 9h17"/><rect x="7" y="12" width="10" height="5" rx=".6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="7" cy="6.5" r=".9" fill="currentColor"/><circle cx="10.5" cy="6.5" r=".9" fill="currentColor"/><circle cx="14" cy="6.5" r=".9" fill="currentColor"/></svg>
          <div><h3>{k('why_1_title')}</h3><p>{k('why_1_body')}</p></div>
        </article>
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="M12 3l-2 2M12 3l2 2M12 21l-2-2M12 21l2-2M4.2 7.5l2.7-.7M4.2 7.5l.7 2.7M19.8 16.5l-2.7.7M19.8 16.5l-.7-2.7M4.2 16.5l2.7.7M4.2 16.5l.7-2.7M19.8 7.5l-2.7-.7M19.8 7.5l-.7 2.7"/></g></svg>
          <div><h3>{k('why_2_title')}</h3><p>{k('why_2_body')}</p></div>
        </article>
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19.5L15.5 5.2a2.6 2.6 0 013.8 3.6L9 19.2A2.4 2.4 0 015 19.5z"/><path d="M8.6 12.4l3 3M11.6 9.4l3 3"/><path d="M15.5 5.2c1 .3 2 1.4 2.3 2.4"/></g></svg>
          <div><h3>{k('why_3_title')}</h3><p>{k('why_3_body')}</p></div>
        </article>
      </div>
    </section>

    <section id="produktet" class="lp-wrap lp-products">
      <h2 class="lp-section-title lp-center">{k('products_title')}</h2>
      <div class="lp-cards">
        <article class="lp-card">
          <span class="lp-card-img lp-card-figure lr-card-figure">
            <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={t('img_alt_pie_pack')} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>{k('byrek_title')}</h3>
            <p>{k('byrek_sub')}</p>
            <p>{k('byrek_min')}</p>
            <a href={p('/products')} class="lp-btn lp-btn-red lp-card-btn">
              {k('byrek_cta')}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
          </div>
        </article>
        <article class="lp-card">
          <img src={tortillaImage.src} width={tortillaImage.width} height={tortillaImage.height} alt={k('tortilla_alt')} class="lp-card-img" loading="lazy" decoding="async" />
          <div>
            <h3>{k('tortilla_title')}</h3>
            <p>{k('tortilla_sub')}</p>
            <p>{k('tortilla_min')}</p>
            <a href={p('/products/tortilla')} class="lp-btn lp-btn-red lp-card-btn">
              {k('tortilla_cta')}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
          </div>
        </article>
      </div>
      <p class="lp-min">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="17.5" cy="17.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        {k('min_delivery')}
      </p>
    </section>

    <section class="lp-band">
      <div class="lp-wrap lp-band-inner">
        <div><h2>{k('cta_title')}</h2><p>{k('cta_body')}</p></div>
        <div class="lp-band-actions">
          <button type="button" class="lp-btn lp-btn-white" data-open-modal="sample">{k('cta_band_primary')}</button>
          <a href={PHONE_HREF} class="lp-band-call">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01z"/></svg>
            {k('cta_call')}
          </a>
        </div>
      </div>
    </section>

    <a href={PHONE_HREF} class="lp-callbar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01z"/></svg>
      {k('call_now')}
    </a>
  </div>

  <ModalHost client:load lang={lang} messages={messages} sampleSource="supply_lokale_restorante" closeOnSampleSuccess={true} />
</BaseLayout>

<script>
  // Same modal bridge as Home.astro / Products.astro: the static buttons
  // dispatch an event the ModalHost island listens for, with the pending slot
  // covering a click that lands before the island has hydrated.
  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.openModal;
      (window as any).__gfPendingModal = name;
      window.dispatchEvent(new CustomEvent('gf:open-modal', { detail: name }));
      document.querySelector<HTMLDetailsElement>('.lp-menu')?.removeAttribute('open');
    });
  });
</script>
