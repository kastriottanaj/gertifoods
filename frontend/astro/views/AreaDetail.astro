---
// Astro port of src/pages/AreaDetail.jsx.
//
// The React file carries six near-identical components (KosovoDetail,
// AlbaniaDetail, …) that differ only in their translation-key prefix, hero
// image, wrapper classes and two small structural flags. They are collapsed
// here into one component driven by the table below — the rendered DOM is
// identical per country, there is just one copy of the markup to keep correct.
//
// The two structural differences the table encodes:
//   hasTime      — Kosovo shows three hero benefits, every other country four.
//   hasLearnMore — Kosovo's segment cards have no "learn more" link.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localePath } from '../lib/i18n.js';
import { areas } from '../../src/data/areas.js';
import kosovoHero from '../../src/assets/gerti-foods-kosovo.webp';
import albaniaHero from '../../src/assets/gerti-foods-albania.webp';
import hungaryHero from '../../src/assets/gerti-foods-hungary.webp';
import croatiaHero from '../../src/assets/gerti-foods-croatia.webp';
import slovakiaHero from '../../src/assets/gerti-foods-slovakia.webp';
import germanyHero from '../../src/assets/gerti-foods-germany.webp';
import bakeryImage from '../../src/assets/bakery-interior.webp';
import hotelImage from '../../src/assets/gerti-foods-about-us.webp';
import restaurantImage from '../../src/assets/products/Pie.webp';
import supermarketImage from '../../src/assets/products/Family-pack.webp';

const CALENDLY_URL = 'https://calendly.com/arlinda-gertifoods/30min';

const COUNTRIES = {
  kosovo: {
    hero: kosovoHero,
    pageClass: 'kosovo-page',
    benefitsClass: 'kosovo-benefits',
    hasTime: false,
    hasLearnMore: false,
  },
  albania: {
    hero: albaniaHero,
    pageClass: 'kosovo-page albania-page',
    benefitsClass: 'kosovo-benefits albania-benefits',
    hasTime: true,
    hasLearnMore: true,
  },
  hungary: {
    hero: hungaryHero,
    pageClass: 'kosovo-page hungary-page',
    benefitsClass: 'kosovo-benefits albania-benefits',
    hasTime: true,
    hasLearnMore: true,
  },
  croatia: {
    hero: croatiaHero,
    pageClass: 'kosovo-page hungary-page croatia-page',
    benefitsClass: 'kosovo-benefits albania-benefits',
    hasTime: true,
    hasLearnMore: true,
  },
  slovakia: {
    hero: slovakiaHero,
    pageClass: 'kosovo-page hungary-page slovakia-page',
    benefitsClass: 'kosovo-benefits albania-benefits',
    hasTime: true,
    hasLearnMore: true,
  },
  germany: {
    hero: germanyHero,
    pageClass: 'kosovo-page hungary-page germany-page',
    benefitsClass: 'kosovo-benefits albania-benefits',
    hasTime: true,
    hasLearnMore: true,
  },
};

// Segment cards: same five, same images, same icons for every country — only
// the translation-key prefix changes.
// The fourth entry is the alt-text key: these five photos are reused on every
// country page, so the description belongs to the image, not the segment.
const SEGMENTS = [
  ['bakeries', bakeryImage, '♨', 'img_alt_bakery_interior'],
  ['hotels', hotelImage, '⌂', 'img_alt_production_line'],
  ['restaurants', restaurantImage, '♧', 'img_alt_pie_pack'],
  ['supermarkets', supermarketImage, '▰', 'img_alt_retail_pack'],
  ['catering', restaurantImage, '⌂', 'img_alt_pie_pack'],
];

const { lang, slug, nameKey } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);

const country = COUNTRIES[slug];
const name = t(nameKey);
const k = (suffix) => t(`${slug}_${suffix}`);

// t() hands back the key itself when a string is missing, so this is how the
// page tells a market with confirmed supply facts from one without. See the
// note on `customers` in src/data/areas.js.
const has = (suffix) => t(`${slug}_${suffix}`) !== `${slug}_${suffix}`;
const hasSupply = has('supply_title');
const supplyPoints = [1, 2, 3, 4].filter((n) => has(`supply_${n}_title`));
const faqItems = [1, 2, 3, 4].filter((n) => has(`faq_${n}_q`));
const customers = areas.find((a) => a.slug === slug)?.customers ?? [];
---

{/* SERP copy comes from the per-country *_seo_title / *_meta keys rather than
    being assembled here. The old title stacked two labels and the brand
    ('Kosova | Zonat që Mbulojmë | Gerti Foods') without ever naming what is
    sold, and the description reused hero_body — a 196-character sentence that
    Google cut off mid-clause. Both are hand-written per country now. */}
<BaseLayout
  title={k('seo_title')}
  description={k('meta')}
  lang={lang}
  appClass={` ${slug}-landing-app`}
  brandSuffix={false}
>
  <div class={country.pageClass}>
    <section class="kosovo-hero">
      <img src={country.hero.src} width={country.hero.width} height={country.hero.height} alt={k('hero_alt')} class="kosovo-hero-image" fetchpriority="high" />
      <div class="kosovo-hero-shade"></div>
      <div class="kosovo-hero-content">
        <nav class="kosovo-breadcrumb"><a href={p('/areas')}>{t('areas_title')}</a> / <span>{name}</span></nav>
        <h1>{k('hero_line_1')}<br />{k('hero_line_2')} <strong>{k('hero_region')}</strong></h1>
        <p>{k('hero_body')}</p>
        <div class={country.benefitsClass}>
          <article><i>▱</i><div><b>{k('delivery')}</b><span>{k('delivery_body')}</span></div></article>
          <article><i>◎</i><div><b>{k('quality')}</b><span>{k('quality_body')}</span></div></article>
          <article><i>♧</i><div><b>{k('support')}</b><span>{k('support_body')}</span></div></article>
          {country.hasTime && (
            <article><i>◷</i><div><b>{k('time')}</b><span>{k('time_body')}</span></div></article>
          )}
        </div>
        <div class="kosovo-hero-actions"><a href={p('/products')}>{t('areas_cta_products')}</a><a href={p('/areas')}>← &nbsp; {t('area_back')}</a></div>
      </div>
    </section>

    <section class="kosovo-segments">
      <h2>{k('serve_title')}</h2>
      <div class="kosovo-segment-grid">
        {SEGMENTS.map(([segment, image, icon, altKey]) => (
          <article>
            <img src={image.src} width={image.width} height={image.height} alt={t(altKey)} loading="lazy" decoding="async" />
            <i>{icon}</i>
            <div>
              <h3>{k(`segment_${segment}`)}</h3>
              <p>{k(`segment_${segment}_body`)}</p>
              {country.hasLearnMore && (
                <a href={p('/products')} class="albania-learn">{t('about_view_products')} →</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Per-market supply facts and the questions they answer. Rendered only
        when sales has confirmed the facts for this market (see areas.js);
        the last point lists the customers we may name, with their links. */}
    {hasSupply && (
      <section class="area-supply">
        <div class="area-supply-heading"><h2>{k('supply_title')}</h2><p>{k('supply_intro')}</p></div>
        <div class="area-supply-grid">
          {supplyPoints.map((n) => (
            <article>
              <h3>{k(`supply_${n}_title`)}</h3>
              <p>
                {k(`supply_${n}_body`)}
                {n === supplyPoints[supplyPoints.length - 1] && customers.length > 0 && (
                  <span class="area-customers">
                    {customers.map((c) => (
                      <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                    ))}
                  </span>
                )}
              </p>
            </article>
          ))}
        </div>
        {faqItems.length > 0 && (
          <div class="area-faq">
            <h2>{k('faq_title')}</h2>
            {faqItems.map((n) => (
              <details>
                <summary>{k(`faq_${n}_q`)}</summary>
                <p>{k(`faq_${n}_a`)}</p>
              </details>
            ))}
          </div>
        )}
      </section>
    )}

    <section class="kosovo-growth"><i>⌕</i><div><h2>{k('growth_title')}</h2><p>{k('growth_body')}</p></div><a href="tel:+38349111150">☎ &nbsp; +383 49 111 150</a><a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer">{t('footer_book_meeting')}</a></section>
    <div class="kosovo-mobile-contact"><a href="tel:+38349111150">☎ &nbsp; {t('products_call_now')}</a><a href="https://wa.me/38349111150" target="_blank" rel="noopener noreferrer">◉ &nbsp; WhatsApp</a></div>
  </div>
</BaseLayout>
