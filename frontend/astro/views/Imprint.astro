---
// Astro port of src/pages/Imprint.jsx — identical markup and classes, but the
// text is resolved at build time instead of by t() in the browser, so the page
// arrives as complete HTML.
//
// Chosen as the migration's first page because it is entirely static: no API
// calls, no forms, no state.
//
// This lives in views/ rather than pages/ because it is rendered once per
// language by two thin route files — pages/imprint.astro (Albanian, at /imprint)
// and pages/[lang]/imprint.astro (English and German, at /en/imprint and
// /de/imprint). Keeping the markup here means one copy of the page regardless of
// how many locales it is built into.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
// Classic section style (red headings, pill buttons, old cards).
import '../styles/sections-classic.css';
// Decorative banner photo: tortillas (the /products hero), not the bakery shot.
import bannerImage from '../../src/assets/products-hero-tortillas.webp';
import { useTranslations, localePath } from '../lib/i18n.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);
---

<BaseLayout
  title={t('imprint_seo_title')}
  description={t('imprint_meta')}
  lang={lang}
  brandSuffix={false}
>
  <div class="imprint-page">
    {/* Tortillas first, then the legal details in one compact card
        (2026-11-22 change list: "Ne fokus TORTILLA, pastaj të dhënat më të
        vogla"). Every legal line is the same text as before. */}
    <PageBanner image={bannerImage}>
      <h1>{t('imprint_title')}</h1>
      <p class="imprint-intro">{t('imprint_tortilla_line')}</p>
      <a href={p('/products/tortilla')} class="imprint-tortilla-cta">{t('imprint_tortilla_cta')} →</a>
    </PageBanner>

    <section class="imprint-legal">
      <p class="imprint-legal-intro">{t('imprint_intro')}</p>
      <dl>
        <dt>{t('imprint_company_heading')}</dt>
        <dd><strong>GERTI FOODS SH.P.K</strong><br />{t('footer_address')}</dd>
        <dt>{t('imprint_contact_heading')}</dt>
        <dd>{t('imprint_phone_label')}: <a href="tel:+38349111150">+383 49 111 150</a><br />{t('imprint_email_label')}: <a href="mailto:info@gertifoods.com">info@gertifoods.com</a></dd>
        <dt>{t('imprint_represented_heading')}</dt>
        <dd>{t('imprint_represented_label')}: Shpejtim Agushaj</dd>
        <dt>{t('imprint_register_heading')}</dt>
        <dd>{t('imprint_register_label')}: 811929126</dd>
        <dt>{t('imprint_content_heading')}</dt>
        <dd>GERTI FOODS SH.P.K — {t('footer_address')}</dd>
      </dl>
      <p class="imprint-disclaimer"><strong>{t('imprint_disclaimer_heading')}.</strong> {t('imprint_disclaimer_body')}</p>
    </section>
  </div>
</BaseLayout>
