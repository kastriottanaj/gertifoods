---
// /furnizim/markete — the markets/supermarkets landing page, built to
// Kastriot's mockup (2026-09-16). Same system as the other redesigned pages
// (LandingHeader, the shared landing.css) with what is its own: the pack in
// front of supermarket shelves as the hero, a two-item meta line (phone and
// the pallet minimum), a tinted certification strip, three product cards —
// the Family Pack with its big "4", single byrek, tortillas — and the
// delivery-times line under them. On phones the text sits on the shelves
// with the pack as a band beneath. The mockup's testimonial is left out.
//
// Copy stays under supply_markete_* in translations.js; the "request a
// quote" buttons open the site's sample/offer modal.
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import ModalHost from '../islands/ModalHost.jsx';
import { islandMessages } from '../lib/islandMessages.js';
import { useTranslations, localePath } from '../lib/i18n.js';
import { breadcrumbSchema, jsonLd } from '../lib/schema.js';
import heroImage from '../../src/assets/markete-hero.webp';
import tortillaImage from '../../src/assets/products/Tortillas.webp';
import '../styles/supply-markete.css';

const PHONE = '+383 49 111 150';
const PHONE_HREF = 'tel:+38349111150';

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);
const k = (suffix) => t(`supply_markete_${suffix}`);
const messages = islandMessages(lang);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema([
      { name: t('footer_home'), url: new URL(p('/'), Astro.site).href },
      { name: t('supply_breadcrumb'), url: new URL(p('/furnizim'), Astro.site).href },
      { name: k('name') },
    ]),
  ],
};
---

<BaseLayout
  title={k('seo_title')}
  description={k('meta')}
  lang={lang}
  appClass=" landing-app markete-landing-app"
  brandSuffix={false}
  showNavbar={false}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd(schema)} />

  <div class="lp mk">
    <LandingHeader lang={lang} ctaLabel={k('cta_primary')} langStyle="name" />

    <section class="lp-hero mk-hero" style={`--mk-hero: url(${heroImage.src})`}>
      <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={k('hero_alt')} class="lp-hero-img" fetchpriority="high" />
      <div class="lp-hero-shade"></div>
      <div class="lp-wrap lp-hero-inner">
        <p class="lp-eyebrow">{k('eyebrow')}</p>
        <h1>{k('hero_line_1')}<br />{k('hero_line_2')}</h1>
        <p class="lp-hero-body">{k('hero_body')}</p>
        <div class="lp-hero-actions">
          <button type="button" class="lp-btn lp-btn-red" data-open-modal="sample">
            {k('cta_primary')}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
          </button>
          <a href="#produktet" class="lp-btn lp-btn-outline">
            {k('cta_secondary')}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11 4v12.17l-5.59-5.58L4 12l8 8 8-8-1.41-1.41L13 16.17V4z"/></svg>
          </a>
        </div>
        <p class="lp-hero-meta mk-hero-meta">
          <a href={PHONE_HREF}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01z"/></svg>
            {PHONE}
          </a>
          <span aria-hidden="true">·</span>
          <span>{k('hero_meta')}</span>
          <span class="mk-hero-min">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>
            {k('hero_min')}
          </span>
        </p>
      </div>
    </section>

    <section class="lp-trust lp-trust-centered mk-trust">
      <div class="lp-wrap lp-trust-inner">
        <div class="lp-trust-lead">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5l7.5 3v5.3c0 5.3-3.6 9.3-7.5 10.7-3.9-1.4-7.5-5.4-7.5-10.7V5.5z"/></svg>
          <b>{k('trust')}</b>
        </div>
        <ul class="lp-trust-list">
          <li>ISO 22000</li><li>HACCP</li><li>IFS</li><li>BRC</li><li>Halal</li>
        </ul>
      </div>
    </section>

    <section class="lp-wrap lp-benefits">
      <h2>{k('why_title')}</h2>
      <div class="lp-benefit-grid">
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2.5l2.2 10.5h10.6L20.5 7H7"/><circle cx="9.5" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></g></svg>
          <div><h3>{k('why_1_title')}</h3><p>{k('why_1_body')}</p></div>
        </article>
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3.5 9h17"/><rect x="7" y="12" width="10" height="5" rx=".6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="7" cy="6.5" r=".9" fill="currentColor"/><circle cx="10.5" cy="6.5" r=".9" fill="currentColor"/><circle cx="14" cy="6.5" r=".9" fill="currentColor"/></svg>
          <div><h3>{k('why_2_title')}</h3><p>{k('why_2_body')}</p></div>
        </article>
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></g></svg>
          <div><h3>{k('why_3_title')}</h3><p>{k('why_3_body')}</p></div>
        </article>
      </div>
    </section>

    <section id="produktet" class="lp-wrap mk-products">
      <h2 class="lp-section-title">{k('products_title')}</h2>
      <div class="mk-cards">
        <article class="mk-card mk-card-pack">
          <span class="mk-four" aria-hidden="true">4</span>
          <div>
            <h3>{k('pack_title')}</h3>
            <p class="mk-pack-count">{k('pack_count')}</p>
            <p class="mk-pack-sub">{k('pack_sub')}</p>
            <p>{k('pack_body')}</p>
            <a href={p('/products/family-pack-pite-4')} class="lp-btn lp-btn-red lp-card-btn">
              {k('pack_cta')}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
          </div>
        </article>
        <article class="mk-card">
          <span class="mk-card-figure">
            <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={t('img_alt_pie_pack')} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>{k('byrek_title')}</h3>
            <p>{k('byrek_body')}</p>
            <a href={p('/products')} class="lp-btn mk-btn-ghost lp-card-btn">
              {k('byrek_cta')}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
          </div>
        </article>
        <article class="mk-card">
          <img src={tortillaImage.src} width={tortillaImage.width} height={tortillaImage.height} alt={k('tortilla_alt')} class="mk-card-img" loading="lazy" decoding="async" />
          <div>
            <h3>{k('tortilla_title')}</h3>
            <p>{k('tortilla_body')}</p>
            <a href={p('/products/tortilla')} class="lp-btn mk-btn-ghost lp-card-btn">
              {k('tortilla_cta')}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
          </div>
        </article>
      </div>
      <p class="mk-delivery">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 6.5A1.5 1.5 0 014.5 5H14v9H3zM14 8h4.2L21 11.2V14h-7z"/><circle cx="7" cy="17" r="2" fill="currentColor"/><circle cx="17.5" cy="17" r="2" fill="currentColor"/></svg>
        <i aria-hidden="true"></i>
        {k('delivery_line')}
      </p>
    </section>

    <section class="lp-band">
      <div class="lp-wrap lp-band-inner">
        <div><h2>{k('cta_title')}</h2><p>{k('cta_body')}</p></div>
        <div class="lp-band-actions mk-band-actions">
          <button type="button" class="lp-btn lp-btn-white" data-open-modal="sample">{k('cta_band_primary')}</button>
          <a href={PHONE_HREF} class="mk-band-call">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01z"/></svg>
            {k('cta_call')}
          </a>
        </div>
      </div>
    </section>

    <a href={PHONE_HREF} class="lp-callbar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01z"/></svg>
      {k('call_now')}
    </a>
  </div>

  <ModalHost client:load lang={lang} messages={messages} sampleSource="supply_markete" closeOnSampleSuccess={true} />
</BaseLayout>

<script>
  // Same modal bridge as Home.astro / Products.astro: the static buttons
  // dispatch an event the ModalHost island listens for, with the pending slot
  // covering a click that lands before the island has hydrated.
  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.openModal;
      (window as any).__gfPendingModal = name;
      window.dispatchEvent(new CustomEvent('gf:open-modal', { detail: name }));
      document.querySelector<HTMLDetailsElement>('.lp-menu')?.removeAttribute('open');
    });
  });
</script>
