---
// The 404 page body, shared by all three locales. The routes that render it
// are pages/404.astro (sq) and pages/[lang]/404.astro (en, de); nginx picks
// between the built files from the URL prefix. See deploy/nginx.conf.
import './NotFound.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localePath } from '../lib/i18n.js';
import heroImage from '../../src/assets/areas-we-serve.webp';

// The site has no contact page, so the two CTAs use the channels the footer
// already publishes: the phone button dials, the support card opens mail.
const PHONE = 'tel:+38349111150';
const EMAIL = 'mailto:info@gertifoods.com';

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);
---

<BaseLayout
  title={t('nf_title')}
  description={t('nf_meta')}
  lang={lang}
  appClass=" nf-app"
  noindex={true}
>
  <div class="nf-page">
    <section class="nf-hero">
      {/* This page's LCP element. Reuses the truck already shipped for the
          areas hero, so a 404 costs the visitor no image they might not
          have cached. */}
      <img
        class="nf-hero-image"
        src={heroImage.src}
        alt={t('areas_hero_alt')}
        width={heroImage.width}
        height={heroImage.height}
        fetchpriority="high"
      />
      <div class="nf-hero-shade"></div>

      <div class="nf-hero-content">
        {/* Not an <h1>: the heading below is the page's actual subject, and a
            bare numeral as the top-level heading tells a screen reader
            nothing. aria-hidden keeps it decorative — "404" is already
            announced by the heading text and the HTTP status. */}
        <p class="nf-code" aria-hidden="true">404</p>
        <h1 class="nf-heading">{t('nf_heading')}</h1>
        <hr class="nf-rule" />

        <p class="nf-body">{t('nf_body_1')}</p>
        <p class="nf-body">{t('nf_body_2')}</p>

        <div class="nf-actions">
          <a href={p('/')} class="nf-btn nf-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3 10.5 12 3l9 7.5" />
              <path d="M5 9.5V21h14V9.5" />
            </svg>
            {t('nf_cta_home')}
          </a>

          <a href={PHONE} class="nf-btn nf-btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z" />
            </svg>
            {t('nf_cta_contact')}
          </a>
        </div>
      </div>
    </section>

    {/* The reason this page keeps `follow` in its robots tag: three real
        routes back into the site, for the visitor and the crawler alike. */}
    <section class="nf-cards">
      <div class="nf-cards-grid">
        <article class="nf-card">
          <svg class="nf-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 16V8l-9-5-9 5v8l9 5 9-5z" />
            <path d="M3.3 7.5 12 12.5l8.7-5" />
            <path d="M12 12.5V21.5" />
          </svg>
          <h2>{t('nf_products_title')}</h2>
          <p>{t('nf_products_body')}</p>
          <a href={p('/products')} class="nf-card-link">
            {t('nf_products_cta')}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M4 12h15" /><path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        </article>

        <article class="nf-card">
          <svg class="nf-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20 10.5c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 0 1 16 0z" />
            <circle cx="12" cy="10.2" r="2.9" />
          </svg>
          <h2>{t('nav_areas')}</h2>
          <p>{t('nf_areas_body')}</p>
          <a href={p('/areas')} class="nf-card-link">
            {t('nf_areas_cta')}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M4 12h15" /><path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        </article>

        <article class="nf-card">
          <svg class="nf-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
            <path d="M4 14h2.2a1 1 0 0 1 1 1v3.6a1 1 0 0 1-1 1H5.4A1.4 1.4 0 0 1 4 18.2z" />
            <path d="M20 14h-2.2a1 1 0 0 0-1 1v3.6a1 1 0 0 0 1 1h.8a1.4 1.4 0 0 0 1.4-1.4z" />
            <path d="M20 19.6v.6a2 2 0 0 1-2 2h-3.4" />
          </svg>
          <h2>{t('nf_help_title')}</h2>
          <p>{t('nf_help_body')}</p>
          <a href={EMAIL} class="nf-card-link">
            {t('nf_cta_contact')}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M4 12h15" /><path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
