---
// Portal page: robots-disallowed, entirely user-specific, no SEO stake.
// src/pages/Orders.jsx runs as a client-only island — no build-time render, so
// there is never a flash of signed-out state before the real one appears.
// The head tags come from BaseLayout, matching what <SEO> used to inject.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../lib/i18n.js';
import { islandMessages } from '../lib/islandMessages.js';
import OrdersIsland from '../islands/OrdersIsland.jsx';

const { lang } = Astro.props;
const t = useTranslations(lang);
const messages = islandMessages(lang, 'portal');
---

<BaseLayout title={t('orders_title')} description={t('orders_meta')} lang={lang}>
  <OrdersIsland client:only="react" lang={lang} messages={messages} />
</BaseLayout>
