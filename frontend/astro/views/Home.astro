---
// Astro port of src/pages/Home.jsx.
//
// Home.css is imported before BaseLayout so the built stylesheet keeps the
// order Vite produces today (Home.css → App.css → index.css, verified against
// dist/assets/index-*.css). Astro emits CSS in import-graph order, and
// BaseLayout is what pulls in App.css and index.css.
import '../../src/pages/Home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
// The classic (old Karrota/WordPress) style for the hero; the matching red
// header is site-wide (classic-header.css). Astro bundles this into the Home
// stylesheet, which is linked *before*
// BaseLayout's (App.css and index.css). So these rules win on specificity,
// not order: each selector is at least one class more specific than the rule
// it overrides. Keep it that way when editing.
import '../styles/home-classic.css';
import { useTranslations, localePath } from '../lib/i18n.js';
import { islandMessages } from '../lib/islandMessages.js';
import LinkedText from '../components/LinkedText.astro';
import HeroLeadFormIsland from '../islands/HeroLeadFormIsland.jsx';
import ModalHost from '../islands/ModalHost.jsx';
import pieImg from '../../src/assets/products/Pie.webp';
import bakeryInteriorImg from '../../src/assets/bakery-interior.webp';
// Hero video (2026-11-25): tortilla making, at Kastriot's request ("a video
// of tortilla making" as the home background). Stock footage for now, to be
// replaced by Gerti's own factory footage when it is filmed. Two Pexels clips
// (Pexels License: free for commercial use, no attribution, modification
// allowed; no faces shown), joined into a 14.8 s silent loop with a 0.6 s
// crossfade:
//   1. a flour tortilla puffing on a hot plate, pressed by hand
//      https://www.pexels.com/video/close-up-of-shaping-tortilla-12327836/
//   2. a dough ball pressed flat in a tortilla press
//      https://www.pexels.com/video/cook-using-tortilla-press-in-latino-restaurant-9737919/
// The previous loop (Gerti's own phone clips of flatbread dough and a rolled
// wrap, 2026-11-08) showed no tortilla being made.
//   desktop: 1280×720, H.264, ~1.7 MB
//   mobile:  540×960 centre crop, H.264, ~1.0 MB
//   poster:  the loop's first frame (the puffed tortilla), so nothing jumps
//            when playback starts. It is the LCP image.
// All three are imported rather than served from public/, so their URLs are
// content-hashed and cached immutably.
import heroPoster from '../../src/assets/home-hero-tortilla-poster.webp';
import heroVideoDesktop from '../../src/assets/home-hero-tortilla-desktop.mp4';
import heroVideoMobile from '../../src/assets/home-hero-tortilla-mobile.mp4';
// The four tortilla varieties for the band under the hero. Small photos
// (about 170x80), the same ones the tortilla page uses.
import tortillaPlainImg from '../../src/assets/tortilla/plain.webp';
import tortillaVegetableImg from '../../src/assets/tortilla/vegetable.webp';
import tortillaFruitImg from '../../src/assets/tortilla/fruit.webp';
import tortillaCinnamonImg from '../../src/assets/tortilla/cinnamon.webp';
const TORTILLA_VARIANTS = [
  ['plain', tortillaPlainImg],
  ['vegetable', tortillaVegetableImg],
  ['fruit', tortillaFruitImg],
  ['cinnamon', tortillaCinnamonImg],
];
// Home "who we serve" cards: [group label key, [[key, path, icon SVG], ...]].
// Icons: the old cards' restaurant, bag and truck, plus Material Icons
// (Apache 2.0) "fastfood" and "local_bar". Static markup, so set:html is safe.
const SEGMENT_GROUPS = [
  ['segments_group_kosovo', [
    ['fastfood', '/products/tortilla', '<path d="M18.06 22.99h1.66c.84 0 1.53-.64 1.63-1.46L23 5.05h-5V1h-1.97v4.05h-4.97l.3 2.34c1.71.47 3.31 1.32 4.27 2.26 1.44 1.42 2.43 2.89 2.43 5.29v8.05zM1 21.99V21h15.03v.99c0 .55-.45 1-1.01 1H2.01c-.56 0-1.01-.45-1.01-1zm15.03-7c0-8-15.03-8-15.03 0h15.03zM1.02 17h15v2h-15z"/>'],
    ['lounge', '/furnizim/lokale-restorante', '<path d="M21 5V3H3v2l8 9v5H6v2h12v-2h-5v-5l8-9zM7.43 7L5.66 5h12.69l-1.78 2H7.43z"/>'],
    ['restaurants', '/furnizim/lokale-restorante', '<path d="M8.1 13.34l2.83-2.83L3.91 3.5a4 4 0 000 5.66l4.19 4.18zm6.78-1.81c1.53.71 3.68.21 5.27-1.38 1.91-1.91 2.28-4.65.81-6.12-1.46-1.46-4.2-1.1-6.12.81-1.59 1.59-2.09 3.74-1.38 5.27L3.7 19.87l1.41 1.41L12 14.41l6.88 6.88 1.41-1.41L13.41 13l1.47-1.47z"/>'],
  ]],
  ['segments_group_europe', [
    ['distributors', '/areas', '<path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm12.5-9.5l1.96 2.5H17V9h1.5zM18 18.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/>'],
    ['supermarkets', '/furnizim/markete', '<path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm0 10c-2.76 0-5-2.24-5-5h2c0 1.66 1.34 3 3 3s3-1.34 3-3h2c0 2.76-2.24 5-5 5z"/>'],
  ]],
];
import tortillaCardImg from '../../src/assets/home-hero-tortillas.webp';

const CERTS = ['ISO 22000'];

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);

// Only the strings the islands render, not the whole translation table.
const messages = islandMessages(lang);
---

<BaseLayout
  title={t('home_seo_title')}
  description={t('home_meta')}
  brandSuffix={false}
  lang={lang}
  preloadImage={heroPoster.src}
  appClass=" home-classic-app"
>
  <div class="home">
    <section class="home-hero home-hero--classic">
      {/* The poster is the LCP image: the one place on this page that gets
          fetchpriority="high" (it is also preloaded in the head). It stays
          visible for anyone who doesn't get the video: reduced motion, data
          saver, or no JS. Both the poster and the video are decorative (the
          H1 carries the message), so the poster has an empty alt and the
          video is hidden from assistive tech. */}
      <img
        class="home-hero-bg"
        src={heroPoster.src}
        alt=""
        width={heroPoster.width}
        height={heroPoster.height}
        fetchpriority="high"
      />
      {/* preload="none": nothing downloads until the script below calls
          play(), after it has checked reduced motion and data saver. The
          desktop source comes first and carries the media query. A browser
          that ignores `media` on <source> therefore always takes the
          desktop file, which is merely more cropped on a phone. The reverse
          order would serve phone video to desktops. */}
      <video
        class="home-hero-video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        disableremoteplayback
        aria-hidden="true"
        data-hero-video
      >
        <source src={heroVideoDesktop} type="video/mp4" media="(min-width: 761px)" />
        <source src={heroVideoMobile} type="video/mp4" />
      </video>
      <div class="home-hero-overlay"></div>

      <div class="home-hero-inner">
        <div class="home-hero-grid">
          <div class="home-hero-copy">
            <span class="home-hero-eyebrow">{t('home_hero_eyebrow')}</span>
            <h1 class="home-hero-title">{t('home_hero_title')}</h1>
            <p class="home-hero-subtitle">{t('home_hero_subtitle')}</p>

            <div class="home-hero-actions">
              <button type="button" class="home-hero-btn-primary" data-open-modal="sample">
                {t('home_hero_cta_samples')}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                </svg>
              </button>
              <a href={p('/products')} class="home-hero-btn-secondary">
                {t('home_hero_cta_products')}
              </a>
            </div>
          </div>

          <div class="home-hero-cta">
            <div class="home-hero-card">
              <HeroLeadFormIsland client:load lang={lang} messages={messages} source="home_hero" />
            </div>
          </div>
        </div>

        <div class="home-hero-bar">
          <div class="home-hero-baritem">
            <span class="home-hero-baricon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              </svg>
            </span>
            <span class="home-hero-bartext">
              <span class="home-hero-barvalue">ISO 22000</span>
              <span class="home-hero-barlabel">{t('hero_stat_certs_label')}</span>
            </span>
          </div>
        </div>
      </div>

      {/* The old site's curved white bottom edge. It is filled with the page
          background, so the hero appears to sit on a rising hill. */}
      <svg class="home-hero-curve" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 140V104C360 36 1080 36 1440 104V140Z" />
      </svg>
    </section>

    {/* Tortilla varieties (2026-11-25): straight after the banner, so the
        first thing below it says "tortillas" (company change list: a visitor
        must see at once that Gerti makes tortillas). Names and lines are the
        tortilla page's own tt_variant_* keys; the photos stay near their own
        small size. */}
    <section class="home-tortilla-band">
      <div class="home-tortilla-band-inner">
        <h2 class="home-tortilla-band-title">{t('home_tortilla_band_title')}</h2>
        <div class="home-tortilla-band-grid">
          {TORTILLA_VARIANTS.map(([key, img]) => (
            <a href={p('/products/tortilla')} class="home-tortilla-variant">
              <img src={img.src} width={img.width} height={img.height} alt={t(`tt_variant_${key}_alt`)} loading="lazy" decoding="async" />
              <h3>{t(`tt_variant_${key}`)}</h3>
              <p>{t(`tt_variant_${key}_body`)}</p>
            </a>
          ))}
        </div>
        <a href={p('/products/tortilla')} class="home-tortilla-band-link">{t('home_tortilla_band_cta')} →</a>
      </div>
    </section>

    <section class="home-segments">
      <div class="home-segments-inner">
        <span class="home-segments-eyebrow">{t('segments_eyebrow')}</span>
        <h2 class="home-segments-title">{t('segments_title')}</h2>
        <p class="home-segments-subtitle">{t('segments_subtitle')}</p>

        {/* Who we serve, aimed at the ad audiences (2026-11-25): venues in
            Kosovo first, then distributors and supermarkets across the
            Balkans and Europe. Rows of three that centre a short last row. */}
        {SEGMENT_GROUPS.map(([labelKey, cards]) => (
          <div class="home-segments-group">
            <p class="home-segments-group-label">{t(labelKey)}</p>
            <div class="home-segments-grid home-segments-grid--group">
              {cards.map(([key, href, icon]) => (
                <a href={p(href)} class="home-segment">
                  <span class="home-segment-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" set:html={icon} />
                  </span>
                  <h3 class="home-segment-title">{t(`segment_${key}_title`)}</h3>
                  <p class="home-segment-body">{t(`segment_${key}_body`)}</p>
                  <span class="home-segment-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" /></svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="home-pain">
      <div class="home-pain-inner">
        <span class="home-pain-eyebrow">{t('pain_eyebrow')}</span>
        <h2 class="home-pain-title">{t('pain_title')}</h2>
        <p class="home-pain-subtitle">{t('pain_subtitle')}</p>

        <div class="home-pain-grid">
          <div class="home-pain-col home-pain-col-without">
            <span class="home-pain-col-label">{t('pain_without_label')}</span>
            <ul class="home-pain-list">
              <li>
                <h3>{t('pain_without_1_title')}</h3>
                <p>{t('pain_without_1_body')}</p>
              </li>
              <li>
                <h3>{t('pain_without_2_title')}</h3>
                <p>{t('pain_without_2_body')}</p>
              </li>
              <li>
                <h3>{t('pain_without_3_title')}</h3>
                <p>{t('pain_without_3_body')}</p>
              </li>
            </ul>
          </div>

          <div class="home-pain-col home-pain-col-with">
            <span class="home-pain-col-label">{t('pain_with_label')}</span>
            <ul class="home-pain-list">
              <li>
                <h3>{t('pain_with_1_title')}</h3>
                <p>{t('pain_with_1_body')}</p>
              </li>
              <li>
                <h3>{t('pain_with_2_title')}</h3>
                <p>{t('pain_with_2_body')}</p>
              </li>
              <li>
                <h3>{t('pain_with_3_title')}</h3>
                <p><LinkedText text={t('pain_with_3_body')} lang={lang} /></p>
              </li>
            </ul>
          </div>
        </div>

        <button type="button" class="home-pain-cta" data-open-modal="sample">
          {t('pain_cta')}
        </button>
      </div>
    </section>

    <section class="home-pillars">
      <div class="home-pillars-inner">
        <span class="home-pillars-eyebrow">{t('pillars_eyebrow')}</span>
        <h2 class="home-pillars-title">{t('pillars_title')}</h2>
        <p class="home-pillars-subtitle">{t('pillars_subtitle')}</p>

        <div class="home-pillars-grid">
          <article class="home-pillar">
            <div class="home-pillar-icon home-pillar-icon-1" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.5 0.67c.74 2.65 3.25 4.73 3.25 7.33 0 2.09-1.67 3.78-3.75 3.78-1.23 0-2.37-.61-3.05-1.64-.4.63-1.1 1.05-1.89 1.05-1.22 0-2.23-1-2.23-2.22 0-.8.4-1.5 1.02-1.91-.48 3.77 2.12 7.43 5.96 7.43 4.07 0 6.19-3.27 6.19-6.75 0-3.16-2-5.97-5.5-7.07z"/>
              </svg>
            </div>
            <div class="home-pillar-text">
              <h3 class="home-pillar-title">{t('pillar_1_title')}</h3>
              <p class="home-pillar-body">{t('pillar_1_body')}</p>
            </div>
          </article>

          <article class="home-pillar">
            <div class="home-pillar-icon home-pillar-icon-2" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              </svg>
            </div>
            <div class="home-pillar-text">
              <h3 class="home-pillar-title">{t('pillar_2_title')}</h3>
              <p class="home-pillar-body">{t('pillar_2_body')}</p>
            </div>
          </article>

          <article class="home-pillar">
            <div class="home-pillar-icon home-pillar-icon-3" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1 2 6v2h20V6L12 1zm-7 9v7H3v2h18v-2h-2v-7h-2v7h-3v-7h-2v7h-2v-7H8v7H5v-7z"/>
              </svg>
            </div>
            <div class="home-pillar-text">
              <h3 class="home-pillar-title">{t('pillar_3_title')}</h3>
              <p class="home-pillar-body">{t('pillar_3_body')}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="home-categories" id="products">
      <div class="home-categories-inner">
        <div class="home-categories-intro">
          <span class="home-categories-eyebrow">{t('categories_eyebrow')}</span>
          <h2 class="home-categories-title">{t('categories_title')}</h2>
          <p class="home-categories-subtitle">{t('categories_subtitle')}</p>
          <a href={p('/products')} class="home-categories-cta">
            {t('categories_cta')}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
            </svg>
          </a>
        </div>

        <div class="home-categories-grid">
          <a href={p('/products/tortilla')} class="home-category">
            {/* The licensed Pexels tortilla photo (the homepage hero until the
                video; also the tortilla page's banner). It replaces the icon
                placeholder for the old-style card, which needs a photo on top.
                TODO: swap for Gerti's own photo once the tortilla shoot lands. */}
            <div class="home-category-image">
              <img
                src={tortillaCardImg.src}
                alt={t('category_tortilla_alt')}
                width={tortillaCardImg.width}
                height={tortillaCardImg.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="home-category-body">
              <h3>{t('category_tortilla_title')}</h3>
              <p>{t('category_tortilla_desc')}</p>
              <span class="home-category-cta">
                {t('categories_view_range')}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                </svg>
              </span>
            </div>
          </a>
          <a href={p('/products')} class="home-category">
            <div class="home-category-image">
              <img
                src={pieImg.src}
                alt={t('category_pite_alt')}
                width="1500"
                height="1600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="home-category-body">
              <h3>{t('category_pite_title')}</h3>
              <p>{t('category_pite_desc')}</p>
              <span class="home-category-cta">
                {t('categories_view_range')}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                </svg>
              </span>
            </div>
          </a>

        </div>
      </div>
    </section>

    <section class="home-process">
      <div class="home-process-inner">
        <span class="home-process-eyebrow">{t('process_eyebrow')}</span>
        <h2 class="home-process-title">{t('process_title')}</h2>
        <p class="home-process-subtitle">{t('process_subtitle')}</p>

        <ol class="home-process-steps">
          <li class="home-process-step">
            <span class="home-process-step-num">01</span>
            <h3 class="home-process-step-title">{t('process_step_1_title')}</h3>
            <p class="home-process-step-body">{t('process_step_1_body')}</p>
          </li>
          <li class="home-process-step">
            <span class="home-process-step-num">02</span>
            <h3 class="home-process-step-title">{t('process_step_2_title')}</h3>
            <p class="home-process-step-body">{t('process_step_2_body')}</p>
          </li>
          <li class="home-process-step">
            <span class="home-process-step-num">03</span>
            <h3 class="home-process-step-title">{t('process_step_3_title')}</h3>
            <p class="home-process-step-body">{t('process_step_3_body')}</p>
          </li>
        </ol>

        <button type="button" class="home-process-cta" data-open-modal="sample">
          {t('process_cta')}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
          </svg>
        </button>
      </div>
    </section>

    <section class="home-capacity">
      <div class="home-capacity-inner">
        <span class="home-capacity-eyebrow">{t('capacity_eyebrow')}</span>
        <h2 class="home-capacity-title">{t('capacity_title')}</h2>
        <p class="home-capacity-subtitle">{t('capacity_subtitle')}</p>

        <div class="home-capacity-grid">
          <div class="home-capacity-stat">
            <span class="home-capacity-value">800</span>
            <span class="home-capacity-label">{t('capacity_stat_byrek')}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-heritage">
      <div class="home-heritage-inner">
        <div class="home-heritage-copy">
          <span class="home-heritage-eyebrow">{t('heritage_eyebrow')}</span>
          <h2 class="home-heritage-title">{t('heritage_title')}</h2>
          <p class="home-heritage-body">{t('heritage_body')}</p>

          <div class="home-heritage-facts">
            <div class="home-heritage-fact">
              <span class="home-heritage-fact-value">3</span>
              <span class="home-heritage-fact-label">{t('heritage_fact_partners')}</span>
            </div>
          </div>

          {/* The rest of the story is on About, which until 2026-11-24 no
              page linked to from its text, only from the menus. */}
          <a href={p('/about')} class="home-heritage-link">{t('heritage_about_link')} →</a>
        </div>

        <div class="home-heritage-media">
          <img
            class="home-heritage-img"
            src={bakeryInteriorImg.src}
            alt={t('heritage_img_alt')}
            loading="lazy"
            decoding="async"
            width="900"
            height="1350"
          />
          <div class="home-heritage-certs">
            <span class="home-heritage-certs-label">{t('heritage_certs_label')}</span>
            <div class="home-heritage-certs-row">
              {CERTS.map((cert) => (
                <span class="home-heritage-cert-badge">{cert}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-final">
      <div class="home-final-inner">
        <div class="home-final-text">
          <h2 class="home-final-title">{t('final_cta_title')}</h2>
          <p class="home-final-body">{t('final_cta_body')}</p>
        </div>

        <div class="home-final-ctas">
          <button type="button" class="home-final-cta-primary" data-open-modal="sample">
            {t('final_cta_primary')}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
            </svg>
          </button>
          <button type="button" class="home-final-cta-catalog" data-open-modal="catalog">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
            </svg>
            {t('final_cta_catalog')}
          </button>
        </div>
      </div>
    </section>

    <div class="home-sticky-cta">
      <button type="button" data-open-modal="sample">
        {t('home_hero_cta_samples')}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
        </svg>
      </button>
    </div>

    {/* Modal.jsx portals to document.body, so this island's position in the
        markup is irrelevant — same as the two <Modal> blocks it replaces,
        which sat mid-page in Home.jsx. */}
    <ModalHost client:load lang={lang} messages={messages} />
  </div>
</BaseLayout>

<script>
  // Bridges the static trigger buttons to the ModalHost island. In Home.jsx
  // these five buttons called setSampleModalOpen / setCatalogModalOpen
  // directly; as plain HTML they dispatch an event instead.
  //
  // The pending slot covers a click landing before the island has hydrated:
  // ModalHost reads it on mount, so an early click opens the modal a moment
  // late rather than doing nothing.
  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.openModal;
      (window as any).__gfPendingModal = name;
      window.dispatchEvent(new CustomEvent('gf:open-modal', { detail: name }));
    });
  });

  // Hero video. It starts here rather than through the autoplay attribute,
  // so these visitors keep the still poster and never download the video:
  //  - those who asked for reduced motion
  //  - those with data saver on
  // It also pauses while the hero is off screen, so the decoder isn't
  // running under the rest of the page. The poster stays underneath and the
  // video fades in on its first frame. If play() is refused (iOS Low Power
  // Mode, say), the visitor just keeps the poster.
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (heroVideo) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as any).connection?.saveData === true;
    if (!reduceMotion && !saveData) {
      heroVideo.muted = true;
      heroVideo.addEventListener('playing', () => heroVideo.classList.add('is-playing'), { once: true });
      const play = () => {
        heroVideo.play().catch(() => {});
      };
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) play();
            else heroVideo.pause();
          }
        }).observe(heroVideo);
      } else {
        play();
      }
    }
  }
</script>
