---
// Astro port of src/pages/Home.jsx.
//
// Home.css is imported before BaseLayout so the built stylesheet keeps the
// order Vite produces today (Home.css → App.css → index.css, verified against
// dist/assets/index-*.css). Astro emits CSS in import-graph order, and
// BaseLayout is what pulls in App.css and index.css.
import '../../src/pages/Home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localePath } from '../lib/i18n.js';
import HeroLeadFormIsland from '../islands/HeroLeadFormIsland.jsx';
import ModalHost from '../islands/ModalHost.jsx';
import pieImg from '../../src/assets/products/Pie.webp';
import familyPackImg from '../../src/assets/products/Family-pack.webp';
import bakeryInteriorImg from '../../src/assets/bakery-interior.webp';

const CERTS = ['ISO 22000', 'HACCP', 'IFS', 'BRC', 'Halal'];

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path) => localePath(lang, path);
---

<BaseLayout
  title={t('home_title')}
  description={t('home_meta')}
  lang={lang}
  preloadHero={true}
>
  <div class="home">
    <section class="home-hero">
      {/* The LCP image — the one place on this page that gets
          fetchpriority="high" (it is also preloaded in the head). Stays
          eager and keeps the default synchronous decode. */}
      <img
        class="home-hero-bg"
        src="/hero.webp"
        alt={t('hero_bg_alt')}
        width="1920"
        height="1280"
        fetchpriority="high"
      />
      <div class="home-hero-overlay"></div>

      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <span class="home-hero-eyebrow">{t('home_hero_eyebrow')}</span>
          <h1 class="home-hero-title">{t('home_hero_title')}</h1>
          <p class="home-hero-subtitle">{t('home_hero_subtitle')}</p>

          <div class="home-hero-actions">
            <button type="button" class="home-hero-btn-primary" data-open-modal="sample">
              {t('home_hero_cta_samples')}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
              </svg>
            </button>
            <a href={p('/products')} class="home-hero-btn-secondary">
              {t('home_hero_cta_products')}
            </a>
          </div>
        </div>

        <div class="home-hero-cta">
          <div class="home-hero-card">
            <HeroLeadFormIsland client:load lang={lang} source="home_hero" />
          </div>
        </div>
      </div>

      <div class="home-hero-bar">
        <div class="home-hero-baritem">
          <span class="home-hero-baricon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
          </span>
          <span class="home-hero-bartext">
            <span class="home-hero-barvalue">ISO 22000</span>
            <span class="home-hero-barlabel">{t('hero_stat_certs_label')}</span>
          </span>
        </div>
        <div class="home-hero-baritem">
          <span class="home-hero-baricon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C9.5 6 8 9 8 12a4 4 0 008 0c0-3-1.5-6-4-10zm-6.5 8C4 12.5 3.5 14.5 4 17c2.2.3 4.2-.6 5.2-2.3-1.4-.8-2.6-2.2-3.7-4.7zm13 0c-1.1 2.5-2.3 3.9-3.7 4.7 1 1.7 3 2.6 5.2 2.3.5-2.5 0-4.5-1.5-7z"/>
            </svg>
          </span>
          <span class="home-hero-bartext">
            <span class="home-hero-barvalue">600</span>
            <span class="home-hero-barlabel">{t('hero_stat_years_label')}</span>
          </span>
        </div>
        <div class="home-hero-baritem">
          <span class="home-hero-baricon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z"/>
            </svg>
          </span>
          <span class="home-hero-bartext">
            <span class="home-hero-barvalue">3,000<span class="home-hero-barunit">/{t('hero_bar_per_hour')}</span></span>
            <span class="home-hero-barlabel">{t('hero_stat_capacity_label')}</span>
          </span>
        </div>
        <div class="home-hero-baritem">
          <span class="home-hero-baricon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 18a8 8 0 110-16 8 8 0 010 16zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
            </svg>
          </span>
          <span class="home-hero-bartext">
            <span class="home-hero-barvalue">15–20 min</span>
            <span class="home-hero-barlabel">{t('hero_stat_baketime_label')}</span>
          </span>
        </div>
      </div>
    </section>

    <section class="home-segments">
      <div class="home-segments-inner">
        <span class="home-segments-eyebrow">{t('segments_eyebrow')}</span>
        <h2 class="home-segments-title">{t('segments_title')}</h2>
        <p class="home-segments-subtitle">{t('segments_subtitle')}</p>

        <div class="home-segments-grid">
          <a href="#products" class="home-segment">
            <span class="home-segment-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2c-1.1 0-2 .9-2 2 0 .38.1.73.29 1.03L8 8v13h2v-7h4v7h2V8l-2.29-2.97c.19-.3.29-.65.29-1.03 0-1.1-.9-2-2-2zm-6 8c-1.1 0-2 .9-2 2v9h2v-9zm12 0v11h2v-9c0-1.1-.9-2-2-2z"/>
              </svg>
            </span>
            <h3 class="home-segment-title">{t('segment_bakeries_title')}</h3>
            <p class="home-segment-body">{t('segment_bakeries_body')}</p>
            <span class="home-segment-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
              </svg>
            </span>
          </a>

          <a href="#products" class="home-segment">
            <span class="home-segment-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M8.1 13.34l2.83-2.83L3.91 3.5a4 4 0 000 5.66l4.19 4.18zm6.78-1.81c1.53.71 3.68.21 5.27-1.38 1.91-1.91 2.28-4.65.81-6.12-1.46-1.46-4.2-1.1-6.12.81-1.59 1.59-2.09 3.74-1.38 5.27L3.7 19.87l1.41 1.41L12 14.41l6.88 6.88 1.41-1.41L13.41 13l1.47-1.47z"/>
              </svg>
            </span>
            <h3 class="home-segment-title">{t('segment_horeca_title')}</h3>
            <p class="home-segment-body">{t('segment_horeca_body')}</p>
            <span class="home-segment-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
              </svg>
            </span>
          </a>

          <a href="#products" class="home-segment">
            <span class="home-segment-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm0 10c-2.76 0-5-2.24-5-5h2c0 1.66 1.34 3 3 3s3-1.34 3-3h2c0 2.76-2.24 5-5 5z"/>
              </svg>
            </span>
            <h3 class="home-segment-title">{t('segment_retail_title')}</h3>
            <p class="home-segment-body">{t('segment_retail_body')}</p>
            <span class="home-segment-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
              </svg>
            </span>
          </a>

          <a href="#products" class="home-segment">
            <span class="home-segment-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm12.5-9.5l1.96 2.5H17V9h1.5zM18 18.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/>
              </svg>
            </span>
            <h3 class="home-segment-title">{t('segment_catering_title')}</h3>
            <p class="home-segment-body">{t('segment_catering_body')}</p>
            <span class="home-segment-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="home-pain">
      <div class="home-pain-inner">
        <span class="home-pain-eyebrow">{t('pain_eyebrow')}</span>
        <h2 class="home-pain-title">{t('pain_title')}</h2>
        <p class="home-pain-subtitle">{t('pain_subtitle')}</p>

        <div class="home-pain-grid">
          <div class="home-pain-col home-pain-col-without">
            <span class="home-pain-col-label">{t('pain_without_label')}</span>
            <ul class="home-pain-list">
              <li>
                <h3>{t('pain_without_1_title')}</h3>
                <p>{t('pain_without_1_body')}</p>
              </li>
              <li>
                <h3>{t('pain_without_2_title')}</h3>
                <p>{t('pain_without_2_body')}</p>
              </li>
              <li>
                <h3>{t('pain_without_3_title')}</h3>
                <p>{t('pain_without_3_body')}</p>
              </li>
            </ul>
          </div>

          <div class="home-pain-col home-pain-col-with">
            <span class="home-pain-col-label">{t('pain_with_label')}</span>
            <ul class="home-pain-list">
              <li>
                <h3>{t('pain_with_1_title')}</h3>
                <p>{t('pain_with_1_body')}</p>
              </li>
              <li>
                <h3>{t('pain_with_2_title')}</h3>
                <p>{t('pain_with_2_body')}</p>
              </li>
              <li>
                <h3>{t('pain_with_3_title')}</h3>
                <p>{t('pain_with_3_body')}</p>
              </li>
            </ul>
          </div>
        </div>

        <button type="button" class="home-pain-cta" data-open-modal="sample">
          {t('pain_cta')}
        </button>
      </div>
    </section>

    <section class="home-pillars">
      <div class="home-pillars-inner">
        <span class="home-pillars-eyebrow">{t('pillars_eyebrow')}</span>
        <h2 class="home-pillars-title">{t('pillars_title')}</h2>
        <p class="home-pillars-subtitle">{t('pillars_subtitle')}</p>

        <div class="home-pillars-grid">
          <article class="home-pillar">
            <div class="home-pillar-icon home-pillar-icon-1" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.5 0.67c.74 2.65 3.25 4.73 3.25 7.33 0 2.09-1.67 3.78-3.75 3.78-1.23 0-2.37-.61-3.05-1.64-.4.63-1.1 1.05-1.89 1.05-1.22 0-2.23-1-2.23-2.22 0-.8.4-1.5 1.02-1.91-.48 3.77 2.12 7.43 5.96 7.43 4.07 0 6.19-3.27 6.19-6.75 0-3.16-2-5.97-5.5-7.07z"/>
              </svg>
            </div>
            <div class="home-pillar-text">
              <h3 class="home-pillar-title">{t('pillar_1_title')}</h3>
              <p class="home-pillar-body">{t('pillar_1_body')}</p>
            </div>
          </article>

          <article class="home-pillar">
            <div class="home-pillar-icon home-pillar-icon-2" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              </svg>
            </div>
            <div class="home-pillar-text">
              <h3 class="home-pillar-title">{t('pillar_2_title')}</h3>
              <p class="home-pillar-body">{t('pillar_2_body')}</p>
            </div>
          </article>

          <article class="home-pillar">
            <div class="home-pillar-icon home-pillar-icon-3" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1 2 6v2h20V6L12 1zm-7 9v7H3v2h18v-2h-2v-7h-2v7h-3v-7h-2v7h-2v-7H8v7H5v-7z"/>
              </svg>
            </div>
            <div class="home-pillar-text">
              <h3 class="home-pillar-title">{t('pillar_3_title')}</h3>
              <p class="home-pillar-body">{t('pillar_3_body')}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="home-categories" id="products">
      <div class="home-categories-inner">
        <div class="home-categories-intro">
          <span class="home-categories-eyebrow">{t('categories_eyebrow')}</span>
          <h2 class="home-categories-title">{t('categories_title')}</h2>
          <p class="home-categories-subtitle">{t('categories_subtitle')}</p>
          <a href={p('/products')} class="home-categories-cta">
            {t('categories_cta')}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
            </svg>
          </a>
        </div>

        <div class="home-categories-grid">
          <a href={p('/products')} class="home-category">
            <div class="home-category-image">
              <img
                src={pieImg.src}
                alt={t('category_pite_alt')}
                width="1500"
                height="1600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="home-category-body">
              <h3>{t('category_pite_title')}</h3>
              <p>{t('category_pite_desc')}</p>
              <span class="home-category-cta">
                {t('categories_view_range')}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                </svg>
              </span>
            </div>
          </a>

          <a href={p('/products')} class="home-category">
            {/* TODO: swap for a real tortilla photo once the shoot lands */}
            <div class="home-category-image home-category-image-placeholder" role="img" aria-label={t('category_tortilla_alt')}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 2.5a7.5 7.5 0 110 15 7.5 7.5 0 010-15zM9 8a1.2 1.2 0 100 2.4A1.2 1.2 0 009 8zm6 1.5a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4zm-4.5 4a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z"/>
              </svg>
            </div>
            <div class="home-category-body">
              <h3>{t('category_tortilla_title')}</h3>
              <p>{t('category_tortilla_desc')}</p>
              <span class="home-category-cta">
                {t('categories_view_range')}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                </svg>
              </span>
            </div>
          </a>

          <a href={p('/products')} class="home-category">
            <div class="home-category-image">
              <img
                src={familyPackImg.src}
                alt={t('category_family_alt')}
                width="1500"
                height="1600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="home-category-body">
              <h3>{t('category_family_title')}</h3>
              <p>{t('category_family_desc')}</p>
              <span class="home-category-cta">
                {t('categories_view_range')}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                </svg>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="home-process">
      <div class="home-process-inner">
        <span class="home-process-eyebrow">{t('process_eyebrow')}</span>
        <h2 class="home-process-title">{t('process_title')}</h2>
        <p class="home-process-subtitle">{t('process_subtitle')}</p>

        <ol class="home-process-steps">
          <li class="home-process-step">
            <span class="home-process-step-num">01</span>
            <h3 class="home-process-step-title">{t('process_step_1_title')}</h3>
            <p class="home-process-step-body">{t('process_step_1_body')}</p>
          </li>
          <li class="home-process-step">
            <span class="home-process-step-num">02</span>
            <h3 class="home-process-step-title">{t('process_step_2_title')}</h3>
            <p class="home-process-step-body">{t('process_step_2_body')}</p>
          </li>
          <li class="home-process-step">
            <span class="home-process-step-num">03</span>
            <h3 class="home-process-step-title">{t('process_step_3_title')}</h3>
            <p class="home-process-step-body">{t('process_step_3_body')}</p>
          </li>
        </ol>

        <button type="button" class="home-process-cta" data-open-modal="sample">
          {t('process_cta')}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
          </svg>
        </button>
      </div>
    </section>

    <section class="home-capacity">
      <div class="home-capacity-inner">
        <span class="home-capacity-eyebrow">{t('capacity_eyebrow')}</span>
        <h2 class="home-capacity-title">{t('capacity_title')}</h2>
        <p class="home-capacity-subtitle">{t('capacity_subtitle')}</p>

        <div class="home-capacity-grid">
          <div class="home-capacity-stat">
            <span class="home-capacity-value">3,000</span>
            <span class="home-capacity-label">{t('capacity_stat_tortilla')}</span>
          </div>
          <div class="home-capacity-stat">
            <span class="home-capacity-value">800</span>
            <span class="home-capacity-label">{t('capacity_stat_byrek')}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-heritage">
      <div class="home-heritage-inner">
        <div class="home-heritage-copy">
          <span class="home-heritage-eyebrow">{t('heritage_eyebrow')}</span>
          <h2 class="home-heritage-title">{t('heritage_title')}</h2>
          <p class="home-heritage-body">{t('heritage_body')}</p>

          <div class="home-heritage-facts">
            <div class="home-heritage-fact">
              <span class="home-heritage-fact-value">3</span>
              <span class="home-heritage-fact-label">{t('heritage_fact_partners')}</span>
            </div>
            <div class="home-heritage-fact">
              <span class="home-heritage-fact-value">600</span>
              <span class="home-heritage-fact-label">{t('heritage_fact_years')}</span>
            </div>
            <div class="home-heritage-fact">
              <span class="home-heritage-fact-value">2024</span>
              <span class="home-heritage-fact-label">{t('heritage_fact_founded')}</span>
            </div>
          </div>
        </div>

        <div class="home-heritage-media">
          <img
            class="home-heritage-img"
            src={bakeryInteriorImg.src}
            alt={t('heritage_img_alt')}
            loading="lazy"
            decoding="async"
            width="900"
            height="1350"
          />
          <div class="home-heritage-certs">
            <span class="home-heritage-certs-label">{t('heritage_certs_label')}</span>
            <div class="home-heritage-certs-row">
              {CERTS.map((cert) => (
                <span class="home-heritage-cert-badge">{cert}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-final">
      <div class="home-final-inner">
        <div class="home-final-text">
          <h2 class="home-final-title">{t('final_cta_title')}</h2>
          <p class="home-final-body">{t('final_cta_body')}</p>
        </div>

        <div class="home-final-ctas">
          <button type="button" class="home-final-cta-primary" data-open-modal="sample">
            {t('final_cta_primary')}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
            </svg>
          </button>
          <button type="button" class="home-final-cta-catalog" data-open-modal="catalog">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
            </svg>
            {t('final_cta_catalog')}
          </button>
        </div>
      </div>
    </section>

    <div class="home-sticky-cta">
      <button type="button" data-open-modal="sample">
        {t('home_hero_cta_samples')}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
        </svg>
      </button>
    </div>

    {/* Modal.jsx portals to document.body, so this island's position in the
        markup is irrelevant — same as the two <Modal> blocks it replaces,
        which sat mid-page in Home.jsx. */}
    <ModalHost client:idle lang={lang} />
  </div>
</BaseLayout>

<script>
  // Bridges the static trigger buttons to the ModalHost island. In Home.jsx
  // these five buttons called setSampleModalOpen / setCatalogModalOpen
  // directly; as plain HTML they dispatch an event instead.
  //
  // The pending slot covers a click landing before the island has hydrated:
  // ModalHost reads it on mount, so an early click opens the modal a moment
  // late rather than doing nothing.
  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.openModal;
      (window as any).__gfPendingModal = name;
      window.dispatchEvent(new CustomEvent('gf:open-modal', { detail: name }));
    });
  });
</script>
