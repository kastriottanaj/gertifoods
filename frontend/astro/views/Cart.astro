---
// Portal page: robots-disallowed, entirely user-specific, no SEO stake.
// src/pages/Cart.jsx runs as a client-only island — no build-time render, so
// there is never a flash of signed-out state before the real one appears.
// The head tags come from BaseLayout, matching what <SEO> used to inject.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../lib/i18n.js';
import CartIsland from '../islands/CartIsland.jsx';

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={t('cart_title')} description={t('cart_meta')} lang={lang}>
  <CartIsland client:only="react" lang={lang} />
</BaseLayout>
