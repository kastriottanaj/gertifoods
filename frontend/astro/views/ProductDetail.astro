---
// Astro port of src/pages/ProductDetail.jsx.
//
// These are the URLs config/sitemaps.py has been submitting to Google while the
// SPA served them as an empty shell. The product's name, category, price,
// description and minimum order are now in the HTML.
//
// The signed-out state — everything a crawler and an anonymous visitor sees —
// is static HTML. The add-to-cart control is an island that appears only once a
// session is confirmed, and hides the login prompt when it does.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localePath, normalizePath } from '../lib/i18n.js';
import { getProduct } from '../lib/products.js';
import { productCopy } from '../lib/productCopy.js';
import { islandMessages } from '../lib/islandMessages.js';
import { productSchema, breadcrumbSchema } from '../lib/schema.js';
import ProductActions from '../islands/ProductActions.jsx';
import FamilyPackDetail from './FamilyPackDetail.astro';
import CheesePieDetail from './CheesePieDetail.astro';
import MeatPieDetail from './MeatPieDetail.astro';
import SpinachPieDetail from './SpinachPieDetail.astro';
import TunaPieDetail from './TunaPieDetail.astro';

const { lang, slug } = Astro.props;
const t = useTranslations(lang);

const product = await getProduct(slug);

// Localised display copy — ProductDetail.jsx used the raw API fields, which
// left the /en and /de pages showing Albanian names and English descriptions.
const copy = productCopy(t);
const name = copy.name(product);
const description = copy.description(product);
const unit = copy.unit(product);
const category = copy.category(product);
// Head copy only — the visible name and description above are untouched.
// An authored title is already a full SERP line and suppresses the brand
// suffix; a product with no keys yet falls back to the old behaviour.
const seoTitle = copy.seoTitle(product);
const seoDescription = copy.seoDescription(product) ?? description?.slice(0, 160);
const messages = islandMessages(lang);

const isFamilyPack = slug === 'family-pack-pite-4';
const isCheesePie = slug === 'pite-me-djathe';
const isMeatPie = slug === 'pite-me-mish';
const isSpinachPie = slug === 'pite-me-spinaq';
const isTunaPie = slug === 'pite-me-tuna';
const isLandingDetail = isFamilyPack || isCheesePie || isMeatPie || isSpinachPie;

// Same normalisation BaseLayout applies before emitting the canonical, so the
// schema and the <link rel="canonical"> name the identical URL. Deriving it
// here rather than hard-coding the origin keeps each language edition pointing
// at itself instead of all three claiming the Albanian one.
const canonical = new URL(normalizePath(Astro.url.pathname), Astro.site).href;

// The Family Pack layout is a request-an-offer page and prints no price; every
// other product page renders "€X / unit" below the heading.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    productSchema({
      product,
      name,
      description,
      category,
      unit,
      canonical,
      showsPrice: !isLandingDetail,
    }),
    breadcrumbSchema([
      { name: t('footer_home'), url: new URL(localePath(lang, '/'), Astro.site).href },
      {
        name: t('nav_products'),
        url: new URL(localePath(lang, '/products'), Astro.site).href,
      },
      { name },
    ]),
  ],
};
---

<BaseLayout
  title={seoTitle ?? name}
  description={seoDescription}
  lang={lang}
  appClass={isFamilyPack ? ' family-pack-app' : isCheesePie ? ' cheese-pie-app' : isMeatPie ? ' meat-pie-app' : isSpinachPie ? ' spinach-pie-app' : isTunaPie ? ' tuna-pie-app' : ''}
  brandSuffix={!seoTitle}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema)}
  />

  {isFamilyPack ? <FamilyPackDetail lang={lang} /> : isCheesePie ? <CheesePieDetail lang={lang} /> : isMeatPie ? <MeatPieDetail lang={lang} /> : isSpinachPie ? <SpinachPieDetail lang={lang} /> : isTunaPie ? <TunaPieDetail lang={lang} /> : <div class="product-detail">
    <div class="product-detail-grid">
      {/* The product shot is the LCP element on this page, so it stays eager
          and is the one image here that gets fetchpriority="high". */}
      {product.image && (
        <img
          src={product.image}
          width={product.image_width}
          height={product.image_height}
          alt={name}
          class="product-detail-image"
          fetchpriority="high"
        />
      )}
      <div class="product-detail-info">
        <span class="product-category-badge">{copy.category(product)}</span>
        <h1>{name}</h1>
        <p class="product-detail-price">&euro;{product.price} / {unit}</p>
        <p class="product-detail-description">{description}</p>
        <p class="product-detail-min">{t('product_min_order')}: {product.min_order_quantity} {unit}</p>

        <ProductActions client:only="react" lang={lang} messages={messages} product={product} unit={unit} />
        <p class="login-prompt" data-product-anon>{t('product_login_prompt')}</p>
      </div>
    </div>
  </div>}
</BaseLayout>
