---
// The single <head> for every Astro page, reproducing frontend/index.html
// exactly — same tags, same order, same inline analytics bootstrap — plus the
// per-route SEO tags that SEO.jsx injects at runtime and prerender.js bakes in
// at build time.
//
// One deliberate difference from prerender.js: the injected tags there carry
// data-rh="true" so react-helmet-async would reconcile rather than duplicate
// them. Astro has no client-side head manager, so the tags are simply final —
// no reconciliation, no duplicate-canonical risk, no helmet in the bundle.
import {
  DEFAULT_LANG,
  SUPPORTED_LANGS,
  OG_LOCALES,
  normalizePath,
  stripLocale,
  alternatePath,
} from '../lib/i18n.js';
// The key the lead forms park a submitted conversion under. Imported rather
// than retyped so the inline pixel script below and conversion.js cannot drift
// apart on the spelling of it.
import { PENDING_LEAD_KEY } from '../../src/lib/conversion.js';
import { organizationSchema, jsonLd } from '../lib/schema.js';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
import WebMCPTools from '../components/WebMCPTools.astro';
import { islandMessages } from '../lib/islandMessages.js';

// Global stylesheets, imported in the same order Vite concatenates them today
// (App.css before index.css — verified against the built bundle) so the cascade
// resolves identically. Home.css is intentionally not imported here; it is
// scoped entirely to .home-* selectors and is loaded by the home page alone.
import '../../src/App.css';
import '../../src/index.css';

const {
  title,
  description,
  lang = DEFAULT_LANG,
  // Only the home page needs the hero preloaded. index.html preloads it for
  // every route because the SPA has one shared HTML shell, which costs every
  // other page a wasted 59 KB download. Per-page HTML lets us scope it.
  preloadHero = false,
  // App.jsx hides the footer on the /products landing page.
  showFooter = true,
  // Landing pages built to their own mockup (the /furnizim/byrektore page)
  // bring their own header and footer, so both site bars can be switched off.
  showNavbar = true,
  // App.jsx appends per-route modifiers to the .app element (e.g.
  // ' products-landing-app', ' kosovo-landing-app') that page-specific CSS
  // hangs off. Pages that need one pass it here.
  appClass = '',
  // Keeps a page out of the index. Set by the 404 pages so Googlebot stops
  // spending crawl budget on the endless supply of URLs that resolve to them,
  // by the thank-you pages, and by the account pages (cart, login, register,
  // profile, orders).
  //
  // The account pages used to rely on a robots.txt Disallow instead. That
  // blocks crawling, not indexing: Google can still list a disallowed URL it
  // finds linked from every page's navbar, and because it may never fetch the
  // page it cannot see any robots meta tag there. A noindex the crawler is
  // allowed to read is the mechanism Google documents for keeping a page out,
  // so these pages now carry it and robots.txt no longer mentions them.
  //
  // 'follow' is deliberate: the page carries real links back into the site
  // (home, products, areas), and dropping them would waste the one useful
  // signal a 404 still has.
  noindex = false,
  // Whether the early <script> below may send a returning visitor to the
  // language edition they previously chose. Only the 404 turns it off — see
  // the comment on the script for why — and it is a separate prop from
  // `noindex` on purpose: the account pages are noindex too, and a German
  // visitor opening /cart must still land on /de/cart.
  langRedirect = true,
  // Whether to append ' | Gerti Foods' to `title`.
  //
  // The indexable pages now carry hand-written SERP titles (the *_seo_title
  // keys) that are already 43–58 characters — at or near the ~60 Google shows
  // before truncating — and some of them name the brand themselves. Appending
  // to those would truncate the homepage at 70 characters and print
  // 'Gerti Foods' twice on the area pages, so they pass brandSuffix={false}
  // and the string reaches <title> verbatim.
  //
  // The default stays true for the account pages (cart, login, register,
  // profile, orders) and the 404, whose titles are short interface labels that
  // read as orphans in a tab or a bookmark without the brand after them.
  brandSuffix = true,
} = Astro.props;

// Mirror SEO.jsx: `${title} | Gerti Foods`, or plain 'Gerti Foods' when unset.
let fullTitle = 'Gerti Foods';
if (title) fullTitle = brandSuffix ? `${title} | Gerti Foods` : title;

// Canonical URL, matching SEO.jsx and the sitemap in config/sitemaps.py.
//
// With build.format: 'file' the build-time pathname carries the on-disk
// extension (/imprint.html), but nginx serves that file at the extensionless
// /imprint via `try_files $uri $uri.html`. Emitting the raw pathname would
// point every canonical at a URL the site does not serve, so strip the
// extension first. In `astro dev` the pathname is already extensionless, so
// this normalisation is a no-op there and both modes agree.
const path = normalizePath(Astro.url.pathname);
const canonical = new URL(path, Astro.site).href;

// hreflang. Every language edition of a page lists all three editions plus
// itself — the reciprocal, self-referencing form Google requires. Without it
// the three editions look like duplicate content competing with each other;
// with it they are alternates, and Google serves the right one per user.
//
// alternatePath rather than localePath(stripLocale(path)): identical for every
// route that shares one slug across the editions, but correct for the ones
// whose slug is itself translated (/en/thank-you <-> /de/danke).
const alternates = SUPPORTED_LANGS.map((code) => ({
  code,
  href: new URL(alternatePath(code, path), Astro.site).href,
}));

// x-default is what Google serves a user whose language matches none of the
// three. Albanian is the site's default edition, so it takes that role.
const xDefault = new URL(alternatePath(DEFAULT_LANG, path), Astro.site).href;

// Where the early redirect below sends a returning visitor who previously chose
// a prefixed language. Computed at build time so the script stays trivial.
const preferredHrefs = Object.fromEntries(
  SUPPORTED_LANGS.filter((c) => c !== DEFAULT_LANG).map((c) => [c, alternatePath(c, path)])
);
const isDefaultLocale = lang === DEFAULT_LANG;

// --- Meta Pixel -----------------------------------------------------------

// The one place the pixel ID is written down. The head script and the
// <noscript> fallback in the body both take it from here.
//
// Replaced 2026-10-05. The original pixel (1627574088940579) sat outside the
// GertiFoods business manager, so its events could not be used by the ad
// account that is about to spend against them. This one was created inside the
// business and is the only pixel the site talks to.
const META_PIXEL_ID = '1396559496012591';

// ViewContent: the pages where a visit is real buying interest, and therefore
// worth building a Custom Audience on and excluding converters from — a product
// detail page, and a /furnizim buyer-segment landing page.
//
// Classified here at build time from the locale-stripped path. Matching
// location.pathname in the browser instead would make every page in the site
// pay for a rule that almost all of them fail.
//
// The listing and city pages (/products, /areas/*) are left out deliberately.
// They sit one click from everything, so firing ViewContent there would fill
// the audience with people who were passing through and dilute the signal the
// ad account optimises against. Adding one back is a line in this table.
//
// No content_type is sent. That field tells Meta the ids name entries in a
// product catalog, and no catalog feed is connected to this pixel — claiming
// one would only produce Events Manager diagnostics about ids matching nothing.
const route = stripLocale(path);
const productSlug = route.match(/^\/products\/(.+)$/)?.[1];
const supplyMatch = route.match(/^\/furnizim(?:\/(.+))?$/);

let pixelContent = null;
if (productSlug) {
  pixelContent = {
    content_ids: [productSlug],
    content_name: title ?? fullTitle,
    content_category: 'product',
  };
} else if (supplyMatch) {
  pixelContent = {
    // The hub page has no slug of its own; name it after its own path so the
    // audience rule can tell the hub from the seven segment pages under it.
    content_ids: [supplyMatch[1] ?? 'furnizim'],
    content_name: title ?? fullTitle,
    content_category: 'supply',
  };
}

// Strings for the exit-intent popup (~1.2 KB). Inlined rather than imported by
// the popup module: keeping LanguageProvider out of the client build is what
// lets Rollup drop the 107 KB translation table entirely.
const exitMessages = islandMessages(lang, 'exit');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    {/* Language preference, replacing LanguageContext's getInitialLang().
        Runs first in <head> so a returning visitor never sees the Albanian page
        flash before their own language loads.

        Two deliberate differences from the React version:

        - It only honours an explicit prior choice from localStorage. The old
          navigator.language sniffing is gone: Google advises against
          auto-redirecting on a guessed language, and a crawler hitting / could
          be bounced to /en, leaving the Albanian edition unindexed.
        - Crawlers have no localStorage, so none of them ever redirect. They
          always see the edition whose URL they requested. */}
    {/* Not on the 404 (langRedirect={false}), which nginx serves under the URL
        the visitor actually asked for. Redirecting there would replace that
        URL with /de/404 — a path that exists on disk and so answers 200,
        quietly turning a genuine 404 into a soft one. nginx already picks the
        right locale's 404 from the URL prefix, so nothing is lost by staying
        put. */}
    {
      isDefaultLocale && langRedirect && (
        <script is:inline define:vars={{ preferredHrefs }}>
          try {
            var choice = localStorage.getItem('gertifoods_lang');
            if (choice && preferredHrefs[choice]) {
              location.replace(preferredHrefs[choice]);
            }
          } catch (e) {}
        </script>
      )
    }

    {
      preloadHero && (
        <link rel="preload" as="image" href="/hero.webp" fetchpriority="high" />
      )
    }

    <!-- Google tag (gtag.js) + Consent Mode v2.

         Consent must be queued before gtag.js is requested. Loading the
         library first leaves a race in which it can initialise without a
         consent default, especially from a warm browser cache. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // GDPR: deny analytics & marketing cookies until the visitor consents.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });

      // Re-apply a previously accepted choice on subsequent visits.
      try {
        if (localStorage.getItem('gf_cookie_consent') === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted'
          });
        }
      } catch (e) {}

      gtag('js', new Date());
      // Keep the automatic page view enabled for every visitor. With
      // analytics_storage denied, Consent Mode sends a cookieless measurement
      // ping rather than reading or writing analytics cookies. Suppressing the
      // event entirely here made every first visit invisible until the banner
      // was accepted and also prevented GA's consent modelling from working.
      gtag('config', 'G-EVDQVNJ5JE');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EVDQVNJ5JE"></script>

    <!-- Meta Pixel Code -->
    <script is:inline define:vars={{ META_PIXEL_ID, PENDING_LEAD_KEY, pixelContent }}>
      // Meta's snippet, with the one line that fetches fbevents.js taken out of
      // it. What remains defines window.fbq and its queue and contacts nobody.
      //
      // The original loaded the library immediately and relied on
      // fbq('consent', 'revoke') to hold the events back. That stops Meta
      // being told what the visitor did, but it does not stop Meta being told
      // the visitor exists: requesting fbevents.js from connect.facebook.net
      // hands over their IP address and the page they are on, before they have
      // agreed to anything. Under GDPR and the ePrivacy rules that request is
      // itself the thing consent is required for, so now nothing is fetched
      // until the banner is answered.
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[]}(window, document,'script');

      // Fetches the library. Called only once consent exists — from the
      // returning-visitor branch below, or by CookieConsent.astro the moment
      // Accept is clicked.
      //
      // Nothing is lost by loading late. Every fbq(...) call made before this
      // runs sits in fbq.queue, and fbevents.js replays the queue in order the
      // moment it arrives: the consent state first, then init with its
      // advanced matching, then PageView and ViewContent. A visitor who reads
      // two pages and then accepts is still counted for both.
      window.gfLoadPixel = function () {
        if (window.gfPixelRequested) return;
        window.gfPixelRequested = true;
        var t = document.createElement('script');
        t.async = true;
        t.src = 'https://connect.facebook.net/en_US/fbevents.js';
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(t, s);
      };

      // Belt and braces: even once the library is loaded, nothing is
      // transmitted until consent is granted. Queued here so it is the first
      // instruction Meta processes.
      fbq('consent', 'revoke');
      try {
        if (localStorage.getItem('gf_cookie_consent') === 'granted') {
          fbq('consent', 'grant');
          window.gfLoadPixel();
        }
      } catch (e) {}

      // Advanced matching. Meta only counts user data as manual advanced
      // matching when it arrives in the init call itself — fbq('set', …) is
      // ignored for this purpose — so the digests a submitted form parked in
      // sessionStorage have to be read here, before init, rather than attached
      // to the Lead event later on.
      //
      // In practice only the thank-you page finds a record: completeLead()
      // writes one immediately before redirecting there and flushPendingLead()
      // removes it on arrival. A redirect the visitor interrupts can leave one
      // behind, in which case their own digests ride along on the next page
      // they open in that tab — harmless, and gone when the tab closes. The values are already SHA-256 hashed by events.js, so no
      // plaintext email or phone number is ever stored or transmitted.
      var gfUserData;
      try {
        var gfPending = sessionStorage.getItem(PENDING_LEAD_KEY);
        if (gfPending) gfUserData = JSON.parse(gfPending).am || undefined;
      } catch (e) {}

      if (gfUserData) fbq('init', META_PIXEL_ID, gfUserData);
      else fbq('init', META_PIXEL_ID);

      // Lets the one form that does not redirect — the catalog request — attach
      // its own advanced matching before it fires Lead. Re-initialising the
      // same pixel is Meta's documented way to supply user data that was not
      // known at page load; their own Tag Manager template does it, and the
      // duplicate-id warning only appears when two init calls land back to
      // back. Defined here so the pixel ID stays in one file.
      window.gfPixelUserData = function (userData) {
        fbq('init', META_PIXEL_ID, userData);
      };

      fbq('track', 'PageView');

      // ViewContent for product and /furnizim pages, classified at build time
      // (see pixelContent above). Sent from here rather than from a bundled
      // script so it does not wait on the JS bundle: a visitor who reads a
      // product page and leaves before it loads still lands in the audience.
      if (pixelContent) fbq('track', 'ViewContent', pixelContent);
    </script>
    <!-- End Meta Pixel Code -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="Gerti Foods" />

    {/* Meta (Facebook) domain verification.
        Claims gertifoods.com for the GertiFoods business portfolio, which is
        what lets Meta attribute conversions to this domain under iOS
        Aggregated Event Measurement — and stops anyone else claiming it in
        their own Business Manager.

        It has to be server-rendered inside <head>: Meta's crawler fetches the
        raw HTML and does not execute JavaScript, so a tag injected at runtime
        would never be seen. Astro writes this into the static HTML of every
        page at build time, so it satisfies that regardless of which URL Meta
        checks. */}
    <meta
      name="facebook-domain-verification"
      content="izq5uco7ndeab80u6lguwnbvmr457c"
    />
    <meta property="og:site_name" content="Gerti Foods" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://gertifoods.com/favicon-512.png" />
    <title>{fullTitle}</title>

    <!-- Per-route SEO tags (SEO.jsx / prerender.js equivalents) -->
    <meta name="description" content={description ?? ''} />
    {/* A noindex page advertises no canonical. Pointing one at itself asks
        Google to index the very URL the robots tag is withdrawing, and the two
        tags together are a contradiction Google resolves unpredictably. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? ''} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {
      SUPPORTED_LANGS.filter((code) => code !== lang).map((code) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[code]} />
      ))
    }

    {/* Reciprocal hreflang across the three editions of this page. Skipped on
        noindex pages: hreflang nominates URLs as indexable alternates of one
        another, which is exactly what a 404 must not do. */}
    {
      !noindex && (
        <>
          {alternates.map(({ code, href }) => (
            <link rel="alternate" hreflang={code} href={href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </>
      )
    }

    <!-- Structured data (schema.org JSON-LD) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd(organizationSchema)}
    />

    {/* Per-page head additions — e.g. the Article JSON-LD a blog post adds on
        top of the site-wide organisation graph. */}
    <slot name="head" />
  </head>
  <body>
    {/* Meta's <noscript> PageView beacon is deliberately absent.
        A <noscript> image fires the instant the document is parsed. It cannot
        read localStorage, cannot be told about consent, and cannot be held
        back — so it reported every no-JS visitor to Meta whether or not they
        had accepted anything, which is precisely what the banner exists to
        prevent. The traffic it measured is a rounding error; the exposure was
        not. */}
    {/* Element order mirrors App.jsx exactly: everything, footer and floating
        widgets included, lives inside .app. */}
    <div class={`app${appClass}`}>
      {showNavbar && <Navbar lang={lang} />}
      <main class="main-content">
        <slot />
      </main>
      {showFooter && <Footer lang={lang} />}
      <WhatsAppButton lang={lang} />
      <CookieConsent lang={lang} />
      <WebMCPTools />
    </div>

    {/* Popup strings as data, not as a define:vars script. define:vars implies
        is:inline, which skips transpilation — the watcher below is TypeScript,
        so inlining it shipped a syntax error to the browser. */}
    <script
      type="application/json"
      id="gf-exit-messages"
      is:inline
      set:html={JSON.stringify(exitMessages).replace(/</g, '\\u003c')}
    />

    <script>
      // Contact: the WhatsApp, phone and email links.
      //
      // For a wholesale bakery these are not a soft signal. Most buyers would
      // sooner ask what a pallet costs than fill in a form, so a large share of
      // real enquiries start with one of these clicks and none of them were
      // being measured at all — neither platform could see them, so neither
      // could optimise for them or retarget the people who made them.
      //
      // Delegated from the document rather than wired per link: there are 37
      // tel: links, 13 wa.me links and 5 mailto: links across the views, and a
      // listener on each would be 55 places to forget. One listener here counts
      // every one, including the floating WhatsApp button, the thank-you page
      // CTA and each number written into a landing page's body.
      //
      // No batching race to defer around, unlike the lead events: wa.me and
      // mailto: open in a new tab or hand off to another app, and tel: hands
      // off to the dialer. This document stays loaded either way, so the hit
      // has time to leave.
      import { track } from '../../src/lib/events.js';

      const CONTACT_CHANNELS: Array<[string, string]> = [
        ['a[href^="https://wa.me/"], a[href*="api.whatsapp.com"]', 'whatsapp'],
        ['a[href^="tel:"]', 'phone'],
        ['a[href^="mailto:"]', 'email'],
      ];

      document.addEventListener('click', (event) => {
        const origin = event.target as Element | null;
        if (!origin || typeof origin.closest !== 'function') return;

        for (const [selector, channel] of CONTACT_CHANNELS) {
          if (!origin.closest(selector)) continue;
          track('contact', {
            // GA4's own convention for "which channel did they use" on a
            // contact-style event.
            ga4: { method: channel, page_path: location.pathname },
            // Meta has no field for it, so it rides in the one Events Manager
            // will break the event down by.
            meta: { content_category: channel },
          });
          return;
        }
      });
    </script>

    <script>
      // Exit-intent watcher — the detection half of the old ExitIntentPopup.jsx,
      // which App.jsx mounted on every route.
      //
      // Only the gates and the listener live here. The modal and the sample
      // form are import()ed the moment exit intent is actually detected, so a
      // visitor who never triggers the popup downloads no React at all and the
      // content pages stay at zero JavaScript. Hydrating it up front instead
      // would have cost every desktop visitor the full framework for a popup
      // that fires rarely and never before five seconds have passed.
      //
      // Thresholds and storage keys are copied verbatim from the original.

      // Set by ANY successful sample-request submission (hero modal or this
      // popup): if present, the popup never shows again this session.
      const SUBMITTED_KEY = 'sample_request_submitted';
      // Set when the visitor closes the popup without submitting.
      const DISMISSED_KEY = 'exit_popup_dismissed';

      // Don't arm until the visitor has been on the page this long — avoids
      // catching immediate bouncers who were never going to convert.
      const ARM_DELAY_MS = 5000;
      // Desktop only: mobile has no cursor, and aggressive mobile substitutes
      // (back-button traps etc.) feel manipulative.
      const MIN_VIEWPORT_WIDTH = 768;
      // Cursor velocity can carry it past clientY=0 before the event fires, so
      // a small threshold catches more real exit attempts.
      const TOP_EDGE_THRESHOLD_PX = 50;

      function alreadyHandled() {
        try {
          return !!(
            sessionStorage.getItem(SUBMITTED_KEY) || sessionStorage.getItem(DISMISSED_KEY)
          );
        } catch {
          return false;
        }
      }

      if (window.innerWidth >= MIN_VIEWPORT_WIDTH && !alreadyHandled()) {
        setTimeout(() => {
          const onMouseOut = (e: MouseEvent) => {
            // relatedTarget is null when the cursor leaves the document
            // entirely, rather than moving between child elements. The clientY
            // check restricts this to top-edge exits — leaving via the sides is
            // not exit intent.
            if (e.relatedTarget || e.clientY > TOP_EDGE_THRESHOLD_PX) return;
            // Disarm before loading so a second exit can't mount it twice.
            document.removeEventListener('mouseout', onMouseOut);
            if (alreadyHandled()) return;

            import('../islands/exitIntentModal.jsx').then(({ default: mount }) => {
              const node = document.getElementById('gf-exit-messages');
              const messages = node ? JSON.parse(node.textContent || '{}') : {};
              mount(document.documentElement.lang || 'sq', messages);
            });
          };

          document.addEventListener('mouseout', onMouseOut);
        }, ARM_DELAY_MS);
      }
    </script>
  </body>
</html>
