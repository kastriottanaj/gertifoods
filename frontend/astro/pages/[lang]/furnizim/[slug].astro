---
// /en/furnizim/byrektore, /de/furnizim/byrektore — every buyer segment in
// every prefixed language, so the hreflang set BaseLayout declares always
// resolves. The slug stays Albanian across editions, like /de/products/pite-me-djathe.
import SupplyLanding from '../../../views/SupplyLanding.astro';
import SupplyByrektore from '../../../views/SupplyByrektore.astro';
import SupplyFurraBuke from '../../../views/SupplyFurraBuke.astro';
import SupplyLokaleRestorante from '../../../views/SupplyLokaleRestorante.astro';
import SupplyMarkete from '../../../views/SupplyMarkete.astro';
import SupplyTirane from '../../../views/SupplyTirane.astro';
import SupplyPrishtine from '../../../views/SupplyPrishtine.astro';
import SupplyLakror from '../../../views/SupplyLakror.astro';
import { PREFIXED_LANGS } from '../../../lib/i18n.js';
import { supplySegments } from '../../../../src/data/supply.js';

export function getStaticPaths() {
  return PREFIXED_LANGS.flatMap((lang) =>
    supplySegments.map((segment) => ({ params: { lang, slug: segment.slug } }))
  );
}

const { lang, slug } = Astro.params;
// Pages redesigned to their own mockup get their own view; the rest share
// SupplyLanding. Add an entry here when the next page gets its design.
const VIEWS = {
  byrektore: SupplyByrektore,
  'furra-buke': SupplyFurraBuke,
  'lokale-restorante': SupplyLokaleRestorante,
  markete: SupplyMarkete,
  tirane: SupplyTirane,
  prishtine: SupplyPrishtine,
  lakror: SupplyLakror,
};
const View = VIEWS[slug] ?? SupplyLanding;
---

<View lang={lang} slug={slug} />
