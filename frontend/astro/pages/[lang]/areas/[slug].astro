---
// /en/areas/kosovo … /de/areas/germany — every country in every prefixed
// language, so each market's landing page exists in that market's language.
import AreaDetail from '../../../views/AreaDetail.astro';
import { PREFIXED_LANGS } from '../../../lib/i18n.js';
import { areas } from '../../../../src/data/areas.js';

export function getStaticPaths() {
  return PREFIXED_LANGS.flatMap((lang) =>
    areas.map((area) => ({
      params: { lang, slug: area.slug },
      props: { nameKey: area.nameKey },
    }))
  );
}

const { lang, slug } = Astro.params;
const { nameKey } = Astro.props;
---

<AreaDetail lang={lang} slug={slug} nameKey={nameKey} />
