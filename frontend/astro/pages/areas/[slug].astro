---
// /areas/kosovo … /areas/germany in Albanian.
import AreaDetail from '../../views/AreaDetail.astro';
import AreaUk from '../../views/AreaUk.astro';
import { DEFAULT_LANG } from '../../lib/i18n.js';
import { areas } from '../../../src/data/areas.js';

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { nameKey: area.nameKey },
  }));
}

const { slug } = Astro.params;
const { nameKey } = Astro.props;
// A country redesigned to its own mockup gets its own view; the rest share
// AreaDetail. Add an entry here when the next one gets its design.
const VIEWS = { uk: AreaUk };
const View = VIEWS[slug] ?? AreaDetail;
---

<View lang={DEFAULT_LANG} slug={slug} nameKey={nameKey} />
