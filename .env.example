DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_NAME=gertifoods
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Admin URL. Leave as 'admin/' in development. In production set a
# non-guessable path under the api/ prefix, e.g. DJANGO_ADMIN_URL=api/staff-3f9k2x/
# (must end with a trailing slash) so the admin login page can't be found by bots.
DJANGO_ADMIN_URL=admin/

# Email / catalog auto-delivery
# In development (DEBUG=True) emails print to the console — leave these blank.
# In production set EMAIL_BACKEND to the SMTP backend and fill in your provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@gertifoods.com
EMAIL_HOST_PASSWORD=your-smtp-password-here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Gerti Foods <info@gertifoods.com>
# Google reCAPTCHA v3 (leave disabled for local development)
RECAPTCHA_ENABLED=False
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=localhost

# Meta Conversions API — the server-side copy of each lead conversion.
# Leave the token blank locally: with no token the whole integration is off and
# nothing is sent to Meta, which is what the test suite and local development
# want. In production set the token only (the rest have working defaults).
#
# Generate it in Events Manager -> the dataset -> Settings -> Conversions API ->
# Generate access token. Treat it like a password: it can write conversions
# into the ad account's dataset.
META_CAPI_ACCESS_TOKEN=
# The pixel/dataset the events belong to. Must match META_PIXEL_ID in
# frontend/astro/layouts/BaseLayout.astro.
META_PIXEL_ID=1396559496012591
# Set to a code from Events Manager -> Test Events to route events to that tab
# for verification instead of counting them. MUST be empty in production.
META_CAPI_TEST_EVENT_CODE=
