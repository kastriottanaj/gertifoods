# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
# Matches venv/, venv312/, venv3.14/ — any interpreter-suffixed environment
# created while testing an upgrade.
venv*/
env/
.venv/

# Django
*.log
local_settings.py
db.sqlite3
media/
staticfiles/

# Environment
.env
# Timestamped copies taken before editing the live .env during a deploy.
# They hold SECRET_KEY and the database password, and they sit inside the
# checkout on the server, so an untracked one is a stray `git add -A` away
# from being committed.
.env.backup-*
.env.production.backup-*

# Node
node_modules/
npm-debug.log*

# Build
frontend/dist/
frontend/build/
frontend/.astro/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code (local user settings)
.claude/
frontend/.env.production
